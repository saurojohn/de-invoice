# Test PDFs generated during invoice layout debugging.
# These are created by `node -e "...generateInvoicePDF(...)"` calls
# and live at the repo root. They're not part of the app — the
# real PDF goes through the HTTP API. Keep them out of git so
# `git status` stays clean during PDF iteration.
test_invoice_*.pdf
test_zugferd_*.pdf

# TypeScript incremental build cache
*.tsbuildinfo
test-results/

# KoSIT Validator JDK (large binary, downloaded by setup-kosit.sh)
infra/java/jdk-*/

# Tier 732: the Mustang ZUGFeRD validator (59 MB; CI fetches it from Maven Central)
infra/mustang/

# Tier 339 audit: leftover Playwright failure-artifact directory
tmp-pw-fail/

# The publisher's DTD (Audicon / Caseware): placed by the operator, not ours to publish; backend/assets/README.md
backend/assets/gdpdu-01-09-2004.dtd
