# ────────────────────────────────────────────────────────────
# de-invoice — backend environment template
# ────────────────────────────────────────────────────────────
# Copy to `backend/.env` and fill in. The dev defaults
# below match the docker-compose.yml + start.sh setup
# so a fresh clone works out of the box. For production,
# generate real secrets (`openssl rand -hex 32`) and
# rotate them every 90 days.
#
# Frontend (Next.js) reads NEXT_PUBLIC_* from its own
# .env / .env.local. See frontend/.env.example.
# ────────────────────────────────────────────────────────────

# Database — matches docker-compose.yml
DATABASE_URL="postgresql://de_invoice:de_invoice_pass@localhost:5432/de_invoice?schema=public"

# Server
PORT=3001
NODE_ENV=development

# Frontend URL (CORS allowlist). Comma-separate multiple
# origins in production. The default is the local dev
# frontend; a deployed build would set this to the
# public hostname.
APP_ORIGIN=http://localhost:3000

# Trust X-Forwarded-* headers from the load balancer.
# 1 = trust one hop (Nginx / Cloudflare typical), 0 = no
# trust (direct connection). Set to 0 in dev.
TRUST_PROXY=0

# JWT signing secret. DEFAULT IS PUBLIC — rotate before
# any real deployment. A leaked JWT secret lets an
# attacker forge session tokens for any user.
JWT_SECRET=change-me-in-production-use-openssl-rand-hex-32

# ─── SMTP (optional in dev) ───────────────────────────────
# The mail service falls back to NO-SMTP mode (logs
# outgoing emails to /tmp/backend.log) when these
# aren't set, so dev / CI work without a real SMTP
# server. In production, fill in the real creds.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME="de-invoice"
SMTP_FROM_EMAIL=

# ─── Scheduled jobs (recurring invoices, …) ───────────────
# Set to "1" to disable all cron triggers. Useful for
# unit tests and CI where you don't want a real cron
# tick to fire mid-test. Defaults to enabled.
DISABLE_CRON=

# ─── VIES (EU VAT) mock mode ─────────────────────────────
# When set to "1", the VatValidationService skips the
# real VIES SOAP call and returns deterministic
# answers based on the VAT ID prefix:
#   VALID...      → valid
#   INVALID...    → invalid
#   UNREACHABLE.../MS_UNAVAILABLE... → unreachable
#   anything else → valid
# Used by the e2e suite (CI can't reliably hit the EU
# service) and by offline dev. Don't set in production.
VIES_MOCK=
