# Database
DATABASE_URL="postgresql://user:password@localhost:5432/de_invoice?schema=public"

# Server
PORT=3001

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# JWT Secret (generate a secure random string)
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# SMTP (for sending invoices via email)
# Use your mail provider's SMTP credentials, e.g. Gmail, IONOS, Strato, Mailgun
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@yourcompany.de
SMTP_PASSWORD=your-smtp-password
SMTP_FROM_NAME=Ihre Firma GmbH
SMTP_FROM_EMAIL=noreply@yourcompany.de

