// German Invoice System - Database Schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================== 组织与用户 ====================

model Company {
  id          String   @id @default(uuid())
  name        String
  legalName   String?
  taxId       String?
  vatId       String?
  address     Json
  bankInfo    Json?
  settings    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       User[]
  customers   Customer[]
  suppliers   Supplier[]
  products    Product[]
  categories  Category[]
  invoices    Invoice[]
  accounts    Account[]
  vouchers    Voucher[]
  auditLogs   AuditLog[]
  emailSends  EmailSend[]
  vatRates    VatRate[]
  vatRateHistories VatRateHistory[]

  @@index([name])
}

model User {
  id                String    @id @default(uuid())
  companyId        String?
  company          Company?  @relation(fields: [companyId], references: [id])
  email            String    @unique
  passwordHash     String
  role             String    @default("user")
  profile          Json?
  preferences      Json?
  createdAt        DateTime  @default(now())
  lastLogin        DateTime?

  createdInvoices  Invoice[] @relation("CreatedBy")
  createdVouchers  Voucher[] @relation("CreatedBy")
  auditLogs        AuditLog[]
  emailSends       EmailSend[]
  createdVatRates   VatRate[] @relation("VatRateCreator")
  changedVatRates   VatRateHistory[] @relation("VatRateChanger")
}

model Customer {
  id           String   @id @default(uuid())
  companyId    String
  company      Company  @relation(fields: [companyId], references: [id])
  type         String   @default("business")
  name         String
  vatId        String?
  taxExempt    Boolean  @default(false)
  address      Json
  contact      Json?
  paymentTerms Int      @default(30)
  creditLimit  Decimal? @db.Decimal(12,2)
  tags         String[]
  metadata     Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  invoices     Invoice[]

  @@index([companyId, name])
  @@index([companyId, vatId])
}

model Supplier {
  id           String   @id @default(uuid())
  companyId    String
  company      Company  @relation(fields: [companyId], references: [id])
  name         String
  vatId        String?
  address      Json
  contact      Json?
  bankInfo     Json?
  paymentTerms Int      @default(30)
  metadata     Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([companyId, name])
}

model Category {
  id           String   @id @default(uuid())
  companyId    String
  company      Company  @relation(fields: [companyId], references: [id])
  parentId     String?
  parent       Category? @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children     Category[] @relation("CategoryHierarchy")
  name         String
  description  String?
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())

  products     Product[]

  @@index([companyId])
}

model Product {
  id                 String    @id @default(uuid())
  companyId         String
  company           Company   @relation(fields: [companyId], references: [id])
  categoryId        String?
  category          Category? @relation(fields: [categoryId], references: [id])
  sku               String?
  name              String
  description       String?
  type              String    @default("good")
  unit              String    @default("piece")
  basePrice         Decimal   @db.Decimal(12,4)
  purchasePrice     Decimal?  @db.Decimal(12,4)
  vatRate           Decimal   @db.Decimal(5,4) @default(0.19)
  stockQuantity     Decimal   @db.Decimal(12,4) @default(0)
  lowStockThreshold Decimal?  @db.Decimal(12,4)
  active            Boolean   @default(true)
  metadata          Json?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  invoiceItems      InvoiceItem[]

  @@index([companyId, sku])
  @@index([companyId, name])
}

model Invoice {
  id              String    @id @default(uuid())
  companyId       String
  company         Company   @relation(fields: [companyId], references: [id])
  customerId      String
  customer        Customer  @relation(fields: [customerId], references: [id])

  invoiceNumber   String
  sequencePrefix String?
  sequenceYear   Int?
  sequenceMonth  Int?
  sequenceNumber Int?

  type           String    @default("INV")
  status         String    @default("draft")

  issueDate      DateTime
  dueDate        DateTime

  subtotal       Decimal   @db.Decimal(12,4) @default(0)
  totalVat       Decimal   @db.Decimal(12,4) @default(0)
  total          Decimal   @db.Decimal(12,4) @default(0)

  currency       String    @default("EUR")
  language       String    @default("de-DE")

  vatBreakdown   Json?
  reverseCharge  Boolean   @default(false)
  euTransaction  Boolean   @default(false)

  notes          String?
  internalNotes  String?

  pdfPath        String?
  attachments    Json?

  createdById    String?
  createdBy      User?     @relation("CreatedBy", fields: [createdById], references: [id])
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  items          InvoiceItem[]
  payments       Payment[]
  emailSends    EmailSend[]
  voucherRef     Voucher?  @relation(fields: [voucherRefId], references: [id])
  voucherRefId   String?   @unique

  @@unique([companyId, invoiceNumber])
  @@index([companyId, issueDate])
  @@index([companyId, customerId])
  @@index([companyId, status])
  @@index([dueDate])
}

model InvoiceItem {
  id              String    @id @default(uuid())
  invoiceId       String
  invoice         Invoice   @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  productId       String?
  product         Product?  @relation(fields: [productId], references: [id])

  description     String
  quantity        Decimal   @db.Decimal(12,4) @default(1)
  unit            String?
  unitPrice       Decimal   @db.Decimal(12,4)
  vatRate         Decimal   @db.Decimal(5,4) @default(0.19)

  discountPercent Decimal?  @db.Decimal(5,2)
  discountAmount Decimal?   @db.Decimal(12,4)

  netAmount       Decimal   @db.Decimal(12,4)
  vatAmount      Decimal   @db.Decimal(12,4)
  grossAmount    Decimal   @db.Decimal(12,4)

  sortOrder      Int       @default(0)
  createdAt      DateTime  @default(now())

  @@index([invoiceId])
}

model Payment {
  id              String    @id @default(uuid())
  invoiceId       String
  invoice         Invoice   @relation(fields: [invoiceId], references: [id])
  amount          Decimal   @db.Decimal(12,4)
  currency        String    @default("EUR")
  paymentDate     DateTime
  paymentMethod   String
  reference       String?
  notes           String?
  receiptNumber   String?
  createdAt       DateTime  @default(now())

  @@index([invoiceId])
  @@index([paymentDate])
}

model Account {
  id            String    @id @default(uuid())
  companyId     String
  company       Company   @relation(fields: [companyId], references: [id])
  accountNumber String
  name          String
  type          String
  category      String?
  parentId      String?
  isVatAccount  Boolean   @default(false)
  active        Boolean   @default(true)
  sortOrder     Int?
  createdAt     DateTime  @default(now())

  voucherLines  VoucherLine[]

  @@unique([companyId, accountNumber])
  @@index([companyId, type])
}

model Voucher {
  id            String    @id @default(uuid())
  companyId     String
  company       Company   @relation(fields: [companyId], references: [id])
  voucherNumber String
  date          DateTime
  description   String?
  referenceType String?
  status        String    @default("draft")
  createdById   String?
  createdBy     User?     @relation("CreatedBy", fields: [createdById], references: [id])
  createdAt     DateTime  @default(now())

  lines         VoucherLine[]
  invoiceRef    Invoice?

  @@unique([companyId, voucherNumber])
  @@index([companyId, date])
}

model VoucherLine {
  id           String    @id @default(uuid())
  voucherId    String
  voucher      Voucher   @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  accountId    String
  account      Account   @relation(fields: [accountId], references: [id])
  description  String?
  debit        Decimal   @db.Decimal(12,4) @default(0)
  credit       Decimal   @db.Decimal(12,4) @default(0)
  vatRate      Decimal?  @db.Decimal(5,4)
  vatAmount    Decimal?   @db.Decimal(12,4)
  sortOrder    Int       @default(0)

  @@index([voucherId])
  @@index([accountId])
}

model VatRate {
  id           String    @id @default(uuid())
  companyId    String?
  company      Company?  @relation(fields: [companyId], references: [id])
  countryCode  String
  rate         Decimal   @db.Decimal(5,4)
  rateType     String
  name         String?
  effectiveFrom DateTime
  effectiveTo  DateTime?
  description  String?
  createdById  String?
  createdBy    User?     @relation("VatRateCreator", fields: [createdById], references: [id])
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  history      VatRateHistory[]

  @@index([countryCode, effectiveFrom])
}

model VatRateHistory {
  id              String    @id @default(uuid())
  vatRateId       String
  vatRate         VatRate   @relation(fields: [vatRateId], references: [id])
  companyId       String
  company         Company   @relation(fields: [companyId], references: [id])
  countryCode     String
  rate            Decimal   @db.Decimal(5,4)
  rateType        String
  effectiveFrom   DateTime
  effectiveTo    DateTime?
  changedById     String?
  changedBy      User?     @relation("VatRateChanger", fields: [changedById], references: [id])
  changedAt       DateTime  @default(now())
  changeReason    String?

  @@index([vatRateId])
}

model EmailSend {
  id              String    @id @default(uuid())
  companyId       String
  company         Company   @relation(fields: [companyId], references: [id])
  invoiceId       String?
  invoice         Invoice?  @relation(fields: [invoiceId], references: [id])
  templateType    String?
  recipientEmail  String
  recipientName  String?
  subject         String?
  bodyPreview     String?
  attachmentPaths Json?
  status          String    @default("opened")
  sentAt          DateTime?
  notes           String?
  createdById     String?
  createdBy       User?     @relation(fields: [createdById], references: [id])
  createdAt       DateTime  @default(now())

  @@index([companyId, invoiceId])
  @@index([createdAt])
}

model AuditLog {
  id          String    @id @default(uuid())
  companyId   String?
  company     Company?  @relation(fields: [companyId], references: [id])
  userId      String?
  user        User?    @relation(fields: [userId], references: [id])
  action      String
  entityType  String?
  entityId    String?
  oldData     Json?
  newData     Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime  @default(now())

  @@index([companyId, createdAt])
  @@index([entityType, entityId])
}
