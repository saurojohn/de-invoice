// German Invoice System - Database Schema

generator client {
  provider = "prisma-client-js"
  // Tier 11: binary engine. The default
  // (library) engine is a prebuilt .node
  // that links against libssl 1.1.x;
  // Debian bookworm-slim (and Alpine
  // 3.18+) ship only openssl 3.x, so the
  // library engine fails to load with
  // "libssl.so.1.1: No such file or
  // directory". The binary engine is a
  // self-contained executable with no
  // libssl dep. Tradeoff: ~10ms slower
  // per query (process fork). On a
  // typical API request the query
  // time is <20ms so this is negligible.
  engineType = "binary"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================== 组织与用户 ====================

model Company {
  id                String   @id @default(uuid())
  name              String
  legalName         String?
  taxId             String?
  vatId             String?
  email             String?
  phone             String?
  fax               String?
  website           String?
  registerEntry     String?  // e.g. "HRB 12345 Amtsgericht Offenbach am Main"
  managingDirector  String?  // Geschäftsführer / Inhaber
  otherInfo         String?  // misc. Impressum / footer info: WEEE number,
                             // Kleinunternehmer §19 UStG disclaimer, etc.
  address           Json
  bankInfo          Json?
  settings          Json?
  logoPath          String?
  invoicePrefix     String?
  // Tier 176: default payment terms in days (already existed).
  // Pre-fills the invoice create form's `dueDate` field
  // (= issueDate + defaultPaymentDays) and is the source
  // of truth for "Zahlbar binnen X Tagen" on the PDF.
  defaultPaymentDays Int     @default(30)
  // Tier 176: default VAT treatment. NULL = "ask every time"
  // (the old behaviour). Set to "standard" / "reverseCharge"
  // / "igL" to auto-pick that radio button on invoice create
  // and pre-stamp the USt-Behandlung on the PDF.
  defaultVatMode    String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  users       User[]
  customers   Customer[]
  suppliers   Supplier[]
  products    Product[]
  categories  Category[]
  invoices    Invoice[]
  recurringInvoices RecurringInvoice[]
  recurringRuns RecurringRun[]
  cashBookEntries CashBookEntry[]
  sepaBatches SepaBatch[]
  // Tier 112: SEPA pain.008 (Lastschrift / direct
  // debit) — mandates, batches, and the per-line
  // collections within each batch.
  sepaDirectDebitMandates   SepaDirectDebitMandate[]
  sepaDirectDebitBatches    SepaDirectDebitBatch[]
  sepaDirectDebitCollections SepaDirectDebitCollection[]
  cashBookDailyCloses CashBookDailyClose[]
  accounts    Account[]
  vouchers    Voucher[]
  auditLogs   AuditLog[]
  errorEvents ErrorEvent[]
  emailSends   EmailSend[]
  mahnungspausen Mahnungspause[]
  bankStatements BankStatement[]
  fintsConnections FinTSConnection[]
  invoiceTemplates InvoiceTemplate[]
  // Tier 130: customer-portal sessions. All
  // CustomerPortalSession rows for a company
  // are listed here (used by the nightly cleanup
  // job that purges expired tokens).
  portalSessions CustomerPortalSession[]
  webhooks      Webhook[]
  mailConfig  MailConfig?
  expenses    Expense[]
  ustvaFilings UStvaFiling[]
  reminderTemplates ReminderTemplate[]
  noteTemplates     NoteTemplate[]
  mahnungen        Mahnung[] 
  vatRates    VatRate[]
  vatRateHistories VatRateHistory[]
  invitations UserInvitation[]
  // Tier 66: users who have access to this Mandant
  // (back-relation of UserCompany).
  userCompanies UserCompany[]
  // Per-company Voucher templates — a saved
  // pre-filled Buchungssatz that the Berater can
  // re-use to create a new Voucher in one click
  // (e.g. "Bankgebühren" = 1200 ↔ 4970). Lines
  // carry the accountId but NOT the amount — the
  // user fills the amount each time the template
  // is used (otherwise the same template would
  // always create the same booking, which is not
  // the intent).
  voucherTemplates VoucherTemplate[]
  // Tier 48: per-(year, costCenter) budget targets.
  costCenterBudgets CostCenterBudget[]
  // Tier 51: all Ratenpläne for this company.
  installmentPlans InstallmentPlan[]
  // Tier 58: all customer credit-balance ledger rows
  // (overpayment, Gutschrift-overage, Auszahlung, apply).
  customerCreditTransactions CustomerCreditTransaction[]
  // Uploaded files (PDF / image scans of incoming
  // invoices, etc.) linked to Expenses / Vouchers
  // by entityType + entityId. Required for GoBD
  // §146 AO: every booking must have the original
  // Beleg attached.
  attachments    Attachment[]
  // VIES (EU VAT) validation history — every check
  // is recorded for the GoBD audit trail so the
  // user can prove the VAT ID was verified at the
  // time of the booking.
  vatValidations VatValidationLog[]

  // Tier 79: Berater Document Exchange notes
  // targeted at this Mandant. Each row is a
  // (Berater → Mandant) message + optional
  // attachment. The Mandant's /dashboard/berater
  // page lists these in a queue.
  beraterNotes BeraterNote[]

  // Tier 83: Anlagenverzeichnis (Sachanlagen).
  // Each Asset is a fixed asset the company
  // owns — Grundstücke, Gebäude, Maschinen,
  // Fahrzeuge, Betriebsausstattung, GWG,
  // Software, etc. The AfaService computes the
  // Buchwert at any snapshot date from the
  // linear AfA schedule; the BilanzService
  // reads the pool to fill the 0100-0500
  // Anlagevermögen positions.
  assets Asset[]

  @@index([name])
}

model User {
  id                String    @id @default(uuid())
  // Tier 66: User.companyId is now the "default
  // login Mandant" — the company the user lands on
  // immediately after login. The actual access
  // control is via UserCompany (many-to-many),
  // which can grant access to multiple companies
  // for a Berater (Steuerberater) who manages
  // several Mandanten.
  companyId        String?
  company          Company?  @relation(fields: [companyId], references: [id])
  // UserCompany back-relation (Tier 66).
  userCompanies    UserCompany[]
  email            String    @unique
  passwordHash     String
  // Role within the company: "admin" | "accountant" | "viewer"
  // The first user of a company is always "admin". Admins can change roles.
  role             String    @default("viewer")
  status           String    @default("active")  // "active" | "inactive"
  profile          Json?
  preferences      Json?
  createdAt        DateTime  @default(now())
  lastLogin        DateTime?
  // Password reset — token is stored hashed, expires 1h after issue
  passwordResetToken       String?
  passwordResetExpires     DateTime?

  // ─── Two-Factor Authentication (TOTP / RFC 6238) ───
  // 2FA is opt-in per user. When enabled, login requires
  // password + a 6-digit code from an authenticator app
  // (Google Authenticator, Authy, 1Password, etc.) OR a
  // one-time recovery code.
  //
  //   twoFactorEnabled   — user has completed setup
  //   twoFactorSecret    — base32 TOTP secret. NEVER
  //                        sent to the frontend after the
  //                        initial setup response.
  //   twoFactorConfirmedAt — when the user successfully
  //                        verified their first code.
  //                        Before this, login still needs
  //                        only the password (so a user
  //                        who started setup but didn't
  //                        finish isn't locked out).
  //   recoveryCodes      — JSON array of bcrypt hashes.
  //                        Each code can be used once. We
  //                        hand the user 10 plain codes at
  //                        setup; only the hashes live in
  //                        the DB.
  twoFactorEnabled       Boolean   @default(false)
  twoFactorSecret        String?
  twoFactorConfirmedAt   DateTime?
  recoveryCodes          Json?

   createdInvoices  Invoice[] @relation("CreatedBy")
   createdVouchers  Voucher[] @relation("CreatedBy")
   auditLogs        AuditLog[]
   errorEvents      ErrorEvent[]
   emailSends       EmailSend[]
   createdVatRates   VatRate[] @relation("VatRateCreator")
   changedVatRates   VatRateHistory[] @relation("VatRateChanger")
   sentInvitations  UserInvitation[] @relation("InvitedBy")
   createdWebhooks  Webhook[] @relation("WebhookCreator")
  createdRecurringInvoices RecurringInvoice[] @relation("RecurringCreator")
  createdCashBookEntries CashBookEntry[] @relation("CashBookEntryCreator")
  closedCashBookDays CashBookDailyClose[] @relation("CashBookDayCloser")
  bankStatements   BankStatement[]   @relation("BankStatementUploader")
  uploadedAttachments Attachment[] @relation("UploadedAttachments")
  // Tier 58: credit-balance ledger entries this user
  // created (Auszahlung, apply, manual adjustments).
  createdCreditTransactions CustomerCreditTransaction[]
  // Tier 64: Mahnungspausen this user created.
  createdMahnungspausen Mahnungspause[]
  // Tier 66: companies this user has access to
  // (a Berater/Steuerberater typically has multiple
  // rows here; a single-Mandant user has exactly one).
  grantedCompanies UserCompany[] @relation("GrantedBy")
  // Tier 79: Berater Document Exchange — notes this
  // user created (the Berater), acknowledged
  // (the Mandant), or dismissed (the Mandant).
  createdBeraterNotes     BeraterNote[] @relation("BeraterNoteCreatedBy")
  acknowledgedBeraterNotes BeraterNote[] @relation("BeraterNoteAcknowledgedBy")
  dismissedBeraterNotes   BeraterNote[] @relation("BeraterNoteDismissedBy")
}

/// Tier 66: Multi-Mandanten-Berater (many-to-many).
///
/// Each row grants a User access to a Company with
/// a specific role. The Berater (Steuerberater)
/// typically has one row per Mandant they manage —
/// the HeaderAuthGuard checks UserCompany on every
/// request to verify the x-company-id is one of the
/// user's granted companies.
///
/// Why a separate table (not a comma-separated
/// companyIds on User): the role can differ per
/// company (e.g. Berater is admin on Mandant A and
/// viewer on Mandant B — a common pattern for
/// read-only auditing engagements).
///
/// Composite PK (userId, companyId) — the (user,company)
/// pair is unique. A user can only have ONE role per
/// company.
///
/// `grantedById` is the admin who added this user
/// to the company (for audit: "who invited the
/// Berater to this Mandant?").
model UserCompany {
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  // Per-company role. Same vocabulary as User.role:
  //   "admin"       — full access (incl. user mgmt)
  //   "accountant"  — invoices / reports / dunning
  //   "viewer"      — read-only
  //   "berater"     — Steuerberater: same as
  //                   accountant + can switch
  //                   Mandant freely without losing
  //                   context. Tier 66 v1 collapses
  //                   "berater" into "admin" for
  //                   permission checks; the value
  //                   is preserved in audit trails.
  role        String   @default("accountant")
  grantedAt   DateTime @default(now())
  grantedById String?
  grantedBy   User?    @relation("GrantedBy", fields: [grantedById], references: [id], onDelete: SetNull)

  @@id([userId, companyId])
  @@index([userId])
  @@index([companyId])
}

// Pending invitations — admin invites employee by email, employee clicks link to register
model UserInvitation {
  id          String   @id @default(uuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])
  email       String
  role        String   @default("accountant")  // "admin" | "accountant" | "viewer"
  // Token — random URL-safe string, also stored hashed (bcrypt) in tokenHash
  tokenHash   String
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdById String
  createdBy   User     @relation("InvitedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  @@index([companyId, email])
  @@index([expiresAt])
}

model Customer {
  id             String   @id @default(uuid())
  companyId      String
  company        Company  @relation(fields: [companyId], references: [id])
  type           String   @default("business")
  name           String
  // Per-company sequential customer number (e.g. "K-0001"), auto-
  // assigned by the service on create if not provided. Unique per
  // company so importers can keep their own numbering scheme.
  customerNumber String?
  vatId          String?
  taxExempt      Boolean  @default(false)
  address        Json
  contact        Json?
  paymentTerms   Int      @default(30)
  creditLimit    Decimal? @db.Decimal(12,2)
  tags           String[]
  metadata       Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Generated text columns + GIN indexes are defined in SQL
  // migrations (not in this Prisma schema — Prisma doesn't have
  // first-class syntax for STORED generated columns).
  //   - pg_trgm GIN on name/vatId/customerNumber + city_text /
  //     postal_code_text pulled out of `address` → see
  //     prisma/init.sql
  //   - search_tsv (Postgres tsvector + GIN, weighted) for full-
  //     text search with snippet highlight → see migration
  //     20260701000001_search_tsv (Tier 28). The column is
  //     generated from name + customerNumber + vatId (weight A),
  //     city_text + postal_code_text (weight B), tags (weight C),
  //     all normalised through unaccent() so "muller" matches
  //     "Müller".
  //
  // The search service in src/modules/search/search.service.ts
  // queries search_tsv via $queryRaw (Prisma's typed-SQL escape
  // hatch). We don't expose the column on the model — keeping it
  // out of the Prisma client forces every caller to use raw SQL,
  // which makes the tsvector @@ tsquery contract explicit.
  // so they live in raw SQL — `prisma db pull` would otherwise drop
  // them.
  cityText           String? @map("city_text")
  postalCodeText     String? @map("postal_code_text")

  invoices     Invoice[]
  recurringInvoices RecurringInvoice[]
  // Tier 51: all Ratenpläne for this customer.
  installmentPlans InstallmentPlan[]
  // Tier 58: immutable ledger of every credit-balance movement
  // (overpayment, Gutschrift-overage, Auszahlung, applied to
  // invoice, manual adjustment). Customer's current credit balance
  // is the SUM(amount) over the rows.
  creditTransactions CustomerCreditTransaction[]
  // Tier 64: Mahnungspausen attached to this customer.
  // (A pause can be customer-level — for all invoices of
  // this customer — or invoice-level — for one specific
  // invoice; the latter is recorded on Invoice.mahnungspausen.)
  mahnungspausen Mahnungspause[]
  // Tier 112: SEPA pain.008 mandates signed by this
  // customer. One customer can sign multiple mandates
  // (e.g. one per subscription, one per product line).
  // Historical mandates that were revoked stay here for
  // audit (the collection rows reference them).
  sepaDirectDebitMandates SepaDirectDebitMandate[]
  // Tier 130: customer-portal sessions (multi-invoice
  // login via email, not per-invoice magic link).
  // One customer can have many concurrent sessions
  // (e.g. one per device, one per shared family
  // email). Expired sessions are deleted by the
  // nightly cleanup job.
  portalSessions CustomerPortalSession[]
  // Tier 145: internal Berater-Notizen on the
  // customer. NOT visible to the customer via
  // the portal or any PDF / email — same
  // visibility rules as InvoiceInternalNote
  // (Tier 138). GoBD § 146 Abs. 4 AO.
  internalNotes CustomerInternalNote[]

  @@index([companyId, name])
  @@index([companyId, vatId])
  @@index([companyId, customerNumber])
  @@unique([companyId, customerNumber])
}

/// Tier 58: customer credit balance (Kundenguthaben) ledger.
///
/// Signed amounts: positive = credit ADDED, negative = credit USED.
/// Sources of credit ADD: overpayment, Gutschrift-overage, manual
/// credit. Sources of credit USE: payout (Auszahlung), apply against
/// a specific invoice, manual debit. See migration SQL for full
/// type list and the `balanceAfter` snapshot semantics.
model CustomerCreditTransaction {
  id            String   @id @default(uuid())
  companyId     String
  company       Company  @relation(fields: [companyId], references: [id])
  customerId    String
  customer      Customer @relation(fields: [customerId], references: [id])
  amount        Decimal  @db.Decimal(12, 4)
  currency      String   @default("EUR")
  // One of: 'overpayment' | 'gutschrift' | 'payout' | 'apply' | 'manual'
  type          String
  // Free-form link to the originating/sinking entity
  // (Invoice.id, Voucher.id, etc.). NULL for manual entries.
  referenceType String?
  referenceId   String?
  // Running balance AFTER this transaction. Computed at write time
  // (read prior balance, add amount, write back) so the statement
  // can render the per-row running balance with a single linear pass.
  balanceAfter  Decimal  @db.Decimal(12, 4)
  description   String?
  createdById   String?
  createdBy     User?    @relation(fields: [createdById], references: [id])
  createdAt     DateTime @default(now())

  @@index([companyId, customerId])
  @@index([customerId, createdAt])
  @@index([type])
  @@index([referenceId])
}

model Supplier {
  id           String   @id @default(uuid())
  companyId    String
  company      Company  @relation(fields: [companyId], references: [id])
  name         String
  vatId        String?
  address      Json
  contact      Json?
  bankInfo     Json?
  paymentTerms Int      @default(30)
  metadata     Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  expenses     Expense[]

  @@index([companyId, name])
}

// Eingangsrechnung / Expense — for input tax (Vorsteuer) calculation
// Used to compute UStVA: payables (Umsatzsteuer) minus input tax (Vorsteuerabzug)
model Expense {
  id              String   @id @default(uuid())
  companyId       String
  company         Company  @relation(fields: [companyId], references: [id])
  supplierId      String?
  supplier        Supplier? @relation(fields: [supplierId], references: [id])
  invoiceNumber   String?
  description     String
  invoiceDate     DateTime
  netAmount       Decimal  @db.Decimal(12,4)
  vatRate         Decimal  @db.Decimal(5,4)    // 0.19, 0.07, 0
  vatAmount       Decimal  @db.Decimal(12,4)
  grossAmount     Decimal  @db.Decimal(12,4)
  category        String?  // e.g. "Material", "Miete", "Bürobedarf"
  // Tier 179: SKR03 Sachkonto for this expense (e.g.
  // "4400" = Wareneingang, "6300" = Miete). The
  // Voucher model has lines with an accountId FK to
  // ChartOfAccount; Expense keeps it as a plain
  // string so the user can stamp the SKR03 account
  // at the Beleg level (before a Voucher is generated
  // by the bank-import flow). Echoed back in the
  // create + list response so the frontend can
  // display the raw account number in the Beleg
  // table.
  accountNumber    String?
  isIntraEU       Boolean  @default(false)      // igE — reverse charge
  isReverseCharge Boolean  @default(false)      // §13b UStG
  status          String   @default("booked")  // booked|deductible|blocked
  notes           String?
  attachmentPath  String?
  // DATEV Kostenstelle 1 + Kostenträger. Same purpose
  // as on Invoice: per-expense cost-center stamp for
  // DATEV columns 12 + 13. Typically the user maps
  // Expense.category → costCenter once in the DATEV
  // account-map settings, but per-expense override is
  // supported when an expense doesn't fit the default.
  costCenter     String?   // DATEV Kostenstelle 1
  costObject     String?   // DATEV Kostenträger
  // Tier 87: when this Expense was auto-posted
  // by the Anlagenverzeichnis "AfA buchen" flow
  // (one row per Asset per Year), these two
  // fields carry the link back to the Asset.
  // NULL for manually-entered expenses. The
  // (relatedAssetId, afaYear) pair is the
  // dedup key for re-running the booking
  // (idempotent: "AfA buchen" twice for the
  // same year = no double booking).
  relatedAssetId String?
  afaYear        Int?
  // Tier 89: 1-12 for the monthly-booking
  // mode (12 rows per asset per year), NULL
  // for the annual-booking mode (1 row per
  // asset per year, dated Dec 31). The
  // (relatedAssetId, afaYear, afaMonth)
  // triple is the dedup key. The two
  // modes are mutually exclusive — the
  // book-afa endpoint leaves afaMonth=NULL;
  // the book-afa-monthly endpoint requires
  // afaMonth IS NULL for all existing rows
  // for the (asset, year) pair, else it
  // fails with "AfA already booked (annual)".
  afaMonth       Int?
  // Tier 108: SEPA pain.001 batch payment tracking.
  // paidAt is set when the user runs a SEPA export
  // and marks the expense as paid (the date is
  // the planned execution date of the SEPA batch,
  // not the actual bank settlement — the bank
  // statement reconciles days later via the
  // auto-import flow). paidBySepaBatchId links
  // the expense to the SepaBatch that paid it.
  // NULL for expenses that haven't been exported
  // via SEPA yet. The (status='booked', paidAt IS NULL)
  // query is the "unpaid expenses" set the Berater
  // sees on /dashboard/payments.
  paidAt         DateTime?
  paidBySepaBatchId String?
  paidBySepaBatch   SepaBatch? @relation("ExpensePaidByBatch", fields: [paidBySepaBatchId], references: [id])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  cashBookEntries CashBookEntry[]

  @@index([companyId, invoiceDate])
  @@index([companyId, vatRate])
  @@index([supplierId])
  @@index([companyId, paidAt])
  @@index([relatedAssetId, afaYear])
  @@index([relatedAssetId, afaYear, afaMonth])
}

// UStVA filing record — track submitted VAT returns
model UStvaFiling {
  id              String   @id @default(uuid())
  companyId       String
  company         Company  @relation(fields: [companyId], references: [id])
  year            Int
  quarter         Int?     // 1-4, or null for monthly (Dauerfristverlängerung)
  month           Int?     // 1-12
  periodLabel     String   // e.g. "2026 Q1" or "2026-03"
  outputVat       Decimal  @db.Decimal(12,4)   // Umsatzsteuer (from sales)
  inputVat        Decimal  @db.Decimal(12,4)   // Vorsteuer (from expenses)
  payableVat      Decimal  @db.Decimal(12,4)   // Differenzbetrag (positive = owe, negative = refund)
  intraEUSales    Decimal  @db.Decimal(12,4) @default(0)   // igL
  intraEUPurchase Decimal  @db.Decimal(12,4) @default(0)   // igE
  status          String   @default("draft")    // draft|submitted|accepted|rejected
  submittedAt     DateTime?
  taxNumber       String?                       // Steuernummer
  notes           String?
  pdfPath         String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([companyId, year, quarter, month])
  @@index([companyId, year])
}

model Category {
  id           String   @id @default(uuid())
  companyId    String
  company      Company  @relation(fields: [companyId], references: [id])
  parentId     String?
  parent       Category? @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children     Category[] @relation("CategoryHierarchy")
  name         String
  description  String?
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())

  products     Product[]

  @@index([companyId])
}

model Product {
  id                 String    @id @default(uuid())
  companyId         String
  company           Company   @relation(fields: [companyId], references: [id])
  categoryId        String?
  category          Category? @relation(fields: [categoryId], references: [id])
  sku               String?
  name              String
  description       String?
  type              String    @default("good")
  unit              String    @default("piece")
  basePrice         Decimal   @db.Decimal(12,4)
  purchasePrice     Decimal?  @db.Decimal(12,4)
  vatRate           Decimal   @db.Decimal(5,4) @default(0.19)
  stockQuantity     Decimal   @db.Decimal(12,4) @default(0)
  lowStockThreshold Decimal?  @db.Decimal(12,4)
  trackInventory    Boolean   @default(false)
  active            Boolean   @default(true)
  metadata          Json?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  invoiceItems      InvoiceItem[]
  stockHistory     ProductStockHistory[]

  // Tier 28: denormalised category name for full-text
  // search. Postgres STORED generated columns can't
  // span relations, so we maintain this column from the
  // service on every Product write (see product.service.ts
  // create / update). The matching migration adds the
  // column with a DEFAULT '' for existing rows.
  categoryName     String    @default("")

  @@index([companyId, sku])
  @@index([companyId, name])
}

model ProductStockHistory {
  id           String    @id @default(uuid())
  productId    String
  product      Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  changeType   String    // 'sale', 'purchase', 'adjustment', 'return', 'initial'
  quantity     Decimal   @db.Decimal(12,4)
  previousQty  Decimal   @db.Decimal(12,4) @default(0)
  newQty       Decimal   @db.Decimal(12,4)
  reference    String?   // invoiceId, purchaseOrderId, etc.
  referenceType String?  // 'invoice', 'purchase', 'manual'
  notes        String?
  createdAt    DateTime  @default(now())

  @@index([productId, createdAt])
}

model Invoice {
  id              String    @id @default(uuid())
  companyId       String
  company         Company   @relation(fields: [companyId], references: [id])
  customerId      String
  customer        Customer  @relation(fields: [customerId], references: [id])

  invoiceNumber   String
  sequencePrefix String?
  sequenceYear   Int?
  sequenceMonth  Int?
  sequenceNumber Int?

  type           String    @default("INV")
  status         String    @default("draft")

  issueDate      DateTime
  dueDate        DateTime?
  // Liefertermin / delivery date — optional. Shown on the
  // PDF next to issueDate when set. §14 UStG doesn't
  // require it, but it's a common B2B practice to put
  // the service-delivery date on an invoice (and
  // relevant for §13b reverse-charge / §25 UStG
  // time-of-supply rules). Left as optional so existing
  // rows don't need a value.
  deliveryDate   DateTime?

  subtotal       Decimal   @db.Decimal(12,4) @default(0)
  totalVat       Decimal   @db.Decimal(12,4) @default(0)
  total          Decimal   @db.Decimal(12,4) @default(0)
  discountPercent Decimal?  @db.Decimal(5,2)
  // Tier 52: Skonto (cash discount for early payment).
  // `skontoPercent` is the discount rate (e.g. 2.00 for 2%)
  // and `skontoDays` is the number of days from issueDate
  // during which the discount is granted. The Skonto
  // window expires at issueDate + skontoDays; payment
  // received after that point doesn't qualify even if
  // the bank-import auto-match thinks it does.
  //
  // Both columns NULL = no Skonto offered. The
  // PDF adds the standard "Zahlbar bis DD.MM. mit X%
  // Skonto, bis DD.MM. ohne Abzug" line when
  // either column is set.
  skontoPercent  Decimal?  @db.Decimal(5,2)
  skontoDays     Int?
  discountAmount Decimal?   @db.Decimal(12,4)

  currency       String    @default("EUR")
  language       String    @default("de-DE")

  // Tier 118: multi-currency support.
  // ECB daily reference rates (fetched by
  // ExchangeRateService) are stored as "1 EUR = X currency"
  // — e.g. 1.1467 for USD, 0.86653 for GBP. The inverse
  // (1 / rate) is the currency → EUR conversion factor.
  //
  // For EUR invoices, `exchangeRate` is 1.0000 and
  // `eurSubtotal`/`eurTotalVat`/`eurTotal` mirror the
  // original amounts (rate=1 → no conversion).
  //
  // For non-EUR invoices, the EUR amounts are computed
  // at issue time using the cached ECB rate and stored
  // on the invoice row. The original currency + total
  // stay on the line items / PDF / XRechnung — the
  // EUR values are only used for AGGREGATION across
  // currencies in EÜR, UStVA, BWA, GuV, etc.
  //
  // Nullable for backward compat: legacy EUR invoices
  // without a rate are treated as rate=1.
  exchangeRate   Decimal?  @db.Decimal(12,6)
  eurSubtotal    Decimal?  @db.Decimal(12,4)
  eurTotalVat    Decimal?  @db.Decimal(12,4)
  eurTotal       Decimal?  @db.Decimal(12,4)

  vatBreakdown   Json?
  reverseCharge  Boolean   @default(false)
  euTransaction  Boolean   @default(false)

  // Tier 28: denormalised customer name snapshot for
  // full-text search. The invoice keeps a copy of the
  // customer's name at issue-time so:
  //   1. The Postgres tsvector STORED column on Invoice
  //      can include it without a relation join
  //      (generated columns can't span relations).
  //   2. Historical invoices don't change when the
  //      customer later renames themselves — a Berater
  //      filtering the journal by customer name sees
  //      what was on the invoice at issue time, not
  //      the current name.
  // The service mirrors Customer.name → customerName
  // on every Invoice create (see invoice.service.ts).
  // The migration adds the column with a backfill from
  // Customer.name for existing rows.
  customerName   String    @default("")

  notes          String?
  internalNotes  String?
  // Tier 138: internal team notes. Never shown
  // to the customer, in the PDF, or in the
  // customer portal — purely internal.
  internalNotesRel  InvoiceInternalNote[]
  templateType   String    @default("standard")
  // DATEV Kostenstelle 1 + Kostenträger. Optional. The
  // user can stamp each invoice with a cost center
  // (e.g. "100" = Vertrieb, "200" = Werkstatt) and an
  // optional cost object (e.g. "PROJ-2026-01" = project
  // code). When set, the DATEV export populates
  // columns 12 + 13 so the Berater can roll up the
  // Buchungsstapel into a Kostenrechnung.
  costCenter     String?   // DATEV Kostenstelle 1 (column 12)
  costObject     String?   // DATEV Kostenträger   (column 13)

  pdfPath        String?
  attachments    Json?

  createdById    String?
  createdBy      User?     @relation("CreatedBy", fields: [createdById], references: [id])
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  items          InvoiceItem[]
  payments       Payment[]
  emailSends    EmailSend[]
  paymentLinks   PaymentLink[]
  // Tier 37: explicit Mahnung audit trail. The old
  // EmailSend rows carried the reminder_* templateType,
  // but didn't expose level-wise totals or late-interest
  // calculations for the dashboard. This new table makes
  // "what Mahnungen went out for this invoice and what
  // did they charge" answerable in one query.
  mahnungen     Mahnung[]
  reconciliations BankReconciliation[] 
  voucherRef     Voucher?  @relation(fields: [voucherRefId], references: [id])
  voucherRefId   String?   @unique
  referenceInvoiceId String?
  referenceInvoice Invoice? @relation("InvoiceReferences", fields: [referenceInvoiceId], references: [id])
  creditNotes    Invoice[] @relation("InvoiceReferences")
  recurringInvoiceId String?
  recurringInvoice   RecurringInvoice? @relation(fields: [recurringInvoiceId], references: [id], onDelete: SetNull)
  recurringRuns  RecurringRun[]
  cashBookEntries CashBookEntry[]
  // Tier 64: invoice-level Mahnungspausen (a pause
  // can be tied to a single invoice, not the whole
  // customer).
  mahnungspausen Mahnungspause[]
  // Tier 51: 1:1 back-relation to the (optional) Ratenplan
  // attached to this invoice. Null when no Ratenplan was
  // set up — the invoice is paid in one lump.
  installmentPlan InstallmentPlan?
  // Tier 112: when this Invoice was collected via a
  // SEPA pain.008 direct-debit batch, this column
  // points to the SepaDirectDebitBatch row. Null when
  // the invoice is settled by a regular bank transfer
  // (Überweisung) or cash. Mirrors the inverse of the
  // SepaBatch.paidBySepaBatchId pattern on Expense
  // (pain.001), but the relation is on the Invoice
  // here because direct debits target the customer's
  // account (and the customer owns the invoice), not
  // the supplier.
  collectedBySepaBatchId String?
  collectedBySepaBatch   SepaDirectDebitBatch? @relation("InvoiceCollectedByBatch", fields: [collectedBySepaBatchId], references: [id])
  // Tier 112: 1:1 back-relation to the (optional)
  // SepaDirectDebitCollection row that targets this
  // invoice. Mirrors the installmentPlan pattern —
  // one Invoice can be collected by at most one direct-
  // debit transaction (you can't double-collect).
  sepaDirectDebitCollection SepaDirectDebitCollection? @relation("InvoiceDirectDebit")

  @@unique([companyId, invoiceNumber])
  @@index([companyId, issueDate])
  @@index([companyId, customerId])
  @@index([companyId, status])
  @@index([companyId, type])
  @@index([dueDate])
}

/// Tier 138: Internal team notes attached to an
/// invoice. Distinct from the customer-facing
/// `Invoice.notes` (Bemerkungen) — these never
/// appear in the PDF, the customer portal, or
/// the email body. GoBD § 146 Abs. 4 AO
/// ("innerbetriebliche Aufzeichnungen") — must
/// be modifiable separately from the invoice
/// data and clearly marked as internal.
///
/// Append-only at the API level: the controller
/// exposes GET + POST + DELETE (own / admin),
/// but no PUT. Edits are modeled as a new
/// note + a tombstone via DELETE on the old
/// one, so the audit trail is clean.
///
/// Cascade on Invoice so a hard-deleted invoice
/// doesn't leave orphan notes.
model InvoiceInternalNote {
  id        String   @id @default(uuid())
  companyId String
  invoiceId String
  invoice   Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  userId    String?
  userEmail String?  // denormalised so deleted users don't blank the display
  body      String
  createdAt DateTime @default(now())

  @@index([companyId, invoiceId, createdAt])
}

/// Tier 145: Berater-Notizen on a customer.
///
/// Parallel to InvoiceInternalNote (Tier 138).
/// Same GoBD § 146 Abs. 4 AO compliance angle:
/// internal communication between Berater +
/// admin that the customer must NEVER see.
/// Goes into a separate table (NOT a field on
/// Customer) so the visibility boundary is
/// enforced at the data layer — there is no
/// way the customer-portal / PDF / email
/// templates can accidentally render these.
///
/// Cascade on Customer so a hard-deleted
/// customer doesn't leave orphan notes.
model CustomerInternalNote {
  id        String   @id @default(uuid())
  companyId String
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  userId    String?
  userEmail String?  // denormalised so deleted users don't blank the display
  body      String
  createdAt DateTime @default(now())

  @@index([companyId, customerId, createdAt])
}

model InvoiceItem {
  id              String    @id @default(uuid())
  invoiceId       String
  invoice         Invoice   @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  productId       String?
  product         Product?  @relation(fields: [productId], references: [id])

  // Produktnummer / SKU as it appears on this specific invoice
  // line. Distinct from Product.sku (the master article
  // number): the invoice value is a snapshot taken at issue
  // time, so editing the product later doesn't rewrite the
  // historical invoice. Also allows per-customer part numbers
  // — the user can override what the product picker auto-
  // filled. Optional because not every line item carries a
  // SKU (e.g. "Beratungsleistungen" on a service invoice).
  productNumber   String?

  description     String
  quantity        Decimal   @db.Decimal(12,4) @default(1)
  unit            String?
  unitPrice       Decimal   @db.Decimal(12,4)
  vatRate         Decimal   @db.Decimal(5,4) @default(0.19)

  netAmount       Decimal   @db.Decimal(12,4)
  vatAmount      Decimal   @db.Decimal(12,4)
  grossAmount    Decimal   @db.Decimal(12,4)

  sortOrder      Int       @default(0)
  createdAt      DateTime  @default(now())

  @@index([invoiceId])
}

model Payment {
  id              String    @id @default(uuid())
  invoiceId       String
  invoice         Invoice   @relation(fields: [invoiceId], references: [id])
  amount          Decimal   @db.Decimal(12,4)
  currency        String    @default("EUR")
  paymentDate     DateTime
  paymentMethod   String
  reference       String?
  notes           String?
  receiptNumber   String?
  createdAt       DateTime  @default(now())

  @@index([invoiceId])
  @@index([paymentDate])
}

/// Customer self-service payment link (Kundenportal).
///
/// Generated per-invoice on demand. Holds an opaque
/// token (32-byte hex) that the customer presents on
/// the public /portal/:token page — no login required.
/// The link expires (default +30d) and is single-use
/// for mark-paid.
///
/// Why a separate table:
///   - Multiple links per invoice (reissue after revoke)
///   - Per-link expiry + per-link usage tracking
///   - CASCADE so deleted invoices clean up their links
///
/// See migration 20260703000001_payment_link for the
/// exact DDL.
model PaymentLink {
  id          String    @id @default(uuid())
  invoiceId   String
  invoice     Invoice   @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  // Opaque token, 32 bytes (16 random bytes hex-encoded
  // = 32 chars). Looked up by GET /portal/:token. The
  // UNIQUE constraint implies a btree index — the
  // portal route hits Postgres with a single equality.
  token       String    @unique
  // expiresAt default +30d set in the service layer.
  // The portal controller returns 404 once expired
  // (so the customer sees "Link abgelaufen" rather
  // than a stale "sie sind bezahlt").
  expiresAt   DateTime
  // Set by POST /portal/:token/mark-paid. After this
  // timestamp, the link is consumed — subsequent hits
  // see the existing Payment instead of letting them
  // re-mark. The audit trail stays (we never delete
  // PaymentLink rows).
  usedAt      DateTime?
  // Admin explicit revoke. Distinct from expiresAt —
  // a revoked link is gone NOW, an expired link is
  // dead past expiresAt. Both return 404 to keep the
  // customer-facing error UX consistent.
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([invoiceId])
}

/// Tier 130: customer-portal session for the multi-
/// invoice view. Different from PaymentLink:
///
///   - PaymentLink   = one token, one invoice, 24h TTL.
///                     Generated by the admin via
///                     "Zahlungslink anzeigen" on the
///                     invoice detail page. Survives
///                     marking-as-paid (reused=true).
///   - PortalSession = one token, ALL of the
///                     customer's invoices, 30d TTL.
///                     Generated by the customer
///                     themselves via "Login per E-Mail"
///                     on the public portal page.
///
/// We do NOT collapse them into a single model:
/// the use cases (admin-issued vs customer-issued),
/// expiry policies, and per-token audit semantics
/// are different enough that one model would be a
/// leaky abstraction. A single customer can have
/// many of each concurrently.
model CustomerPortalSession {
  id          String   @id @default(uuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  // The email the customer typed on the login page.
  // Stored (not just on Customer) so we can audit
  // "who requested this session" later — and so a
  // customer who changes their email in their
  // contact record doesn't lose their existing
  // sessions (the token is bound to the email they
  // typed, not the current contact.email).
  email       String
  // 32 random bytes hex-encoded = 64 chars.
  token       String   @unique
  expiresAt   DateTime
  // Updated every time the customer hits an
  // authenticated portal route. The expiry is
  // sliding — each request extends expiresAt by
  // another 30 days. Idle sessions (> 30 days no
  // activity) auto-expire. The cleanup job runs
  // nightly and deletes expired rows.
  lastUsedAt  DateTime?
  // The IP that requested the session. Stored for
  // the audit log + rate limiting; not enforced
  // (we don't block on IP mismatch — that would
  // break mobile customers who switch networks).
  createdFromIp String?
  createdAt   DateTime @default(now())

  @@index([customerId])
  @@index([expiresAt])
}

model Account {
  id            String    @id @default(uuid())
  companyId     String
  company       Company   @relation(fields: [companyId], references: [id])
  accountNumber String
  name          String
  type          String
  category      String?
  parentId      String?
  isVatAccount  Boolean   @default(false)
  active        Boolean   @default(true)
  sortOrder     Int?
  createdAt     DateTime  @default(now())

  voucherLines  VoucherLine[]

  @@unique([companyId, accountNumber])
  @@index([companyId, type])
}

model Voucher {
  id            String    @id @default(uuid())
  companyId     String
  company       Company   @relation(fields: [companyId], references: [id])
  voucherNumber String
  date          DateTime
  description   String?
  referenceType String?
  status        String    @default("draft")
  createdById   String?
  createdBy     User?     @relation("CreatedBy", fields: [createdById], references: [id])
  createdAt     DateTime  @default(now())

  lines         VoucherLine[]
  invoiceRef    Invoice?
  bankReconciliations BankReconciliation[]
  bankTransactions BankTransaction[]
  // Recon rows that named THIS voucher as the Storno
  // (reversalVoucherId on BankReconciliation). When
  // the user reopens a confirmed match, the Storno
  // voucher links back to the recon via this relation
  // — symmetric to bankReconciliations.
  reversalOf BankReconciliation[] @relation("ReconReversal")
  // GoBD self-relation for Storno-Buchung on Vouchers.
  // When a Voucher is corrected (Berater creates a
  // manual Storno), the new "Korrekturbeleg" Voucher
  // points back to the original via this relation.
  // The original is NEVER mutated — only this new
  // "S<seq>" Voucher with negated lines is added.
  // The original's `reversals` back-relation surfaces
  // all Storno vouchers that point at it.
  reversedBy    Voucher?  @relation("VoucherReversal", fields: [reversedById], references: [id])
  reversedById  String?
  reversals     Voucher[] @relation("VoucherReversal")

  @@unique([companyId, voucherNumber])
  @@index([companyId, date])
}

model VoucherLine {
  id           String    @id @default(uuid())
  voucherId    String
  voucher      Voucher   @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  // Tier 26: nullable so the Sachkonten auto-inference
  // (datev-sachkonto-inference.ts) can populate it
  // after the user creates the line. Pre-Tier 26 this
  // was required, which forced the UI to ask the user
  // for an account upfront — most users don't know
  // SKR03 account numbers off the top of their head,
  // so this was a major friction point. The migration
  // 20260630000002_voucherline_accountid_nullable
  // drops the NOT NULL constraint; existing rows are
  // unaffected (their accountId stays).
  accountId    String?
  account      Account?  @relation(fields: [accountId], references: [id])
  description  String?
  debit        Decimal   @db.Decimal(12,4) @default(0)
  credit       Decimal   @db.Decimal(12,4) @default(0)
  vatRate      Decimal? @db.Decimal(5,4)
  vatAmount    Decimal?   @db.Decimal(12,4)
  sortOrder    Int       @default(0)

  // Tier 41: DATEV Kostenstelle 1 + Kostenträger stamps
  // per line. Mirrors Invoice.costCenter / Expense.costCenter.
  // Tier 41 ships a /vouchers/cost-center-suggestion endpoint
  // that pre-fills these from the most-recent usage on the
  // same Sachkonto. Free-form strings (not FK-restricted),
  // matching the Invoice / Expense columns.
  costCenter   String?
  costObject   String?

  @@index([voucherId])
  @@index([accountId])
  // Tier 41: index on (accountId, costCenter) so the
  // "most-used cost-center for this account" suggestion
  // query (groupBy accountId where costCenter IS NOT NULL,
  // order by _count DESC, take 1) hits the btree directly.
  @@index([accountId, costCenter])
}

model VatRate {
  id           String    @id @default(uuid())
  companyId    String?
  company      Company?  @relation(fields: [companyId], references: [id])
  countryCode  String
  rate         Decimal   @db.Decimal(5,4)
  rateType     String
  name         String?
  effectiveFrom DateTime
  effectiveTo  DateTime?
  description  String?
  createdById  String?
  createdBy    User?     @relation("VatRateCreator", fields: [createdById], references: [id])
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  history      VatRateHistory[]

  @@index([countryCode, effectiveFrom])
}

model VatRateHistory {
  id              String    @id @default(uuid())
  vatRateId       String
  vatRate         VatRate   @relation(fields: [vatRateId], references: [id])
  companyId       String
  company         Company   @relation(fields: [companyId], references: [id])
  countryCode     String
  rate            Decimal   @db.Decimal(5,4)
  rateType        String
  effectiveFrom   DateTime
  effectiveTo    DateTime?
  changedById     String?
  changedBy      User?     @relation("VatRateChanger", fields: [changedById], references: [id])
  changedAt       DateTime  @default(now())
  changeReason    String?

  @@index([vatRateId])
}

// VIES (EU VAT Information Exchange System) validation
// log — every check we do against the EU service
// is recorded here for the GoBD audit trail.
//
// Why a separate table from the live VatValidation
// (the "current best answer") row: we want to keep
// EVERY check (success + failure) so the user can
// prove that the VAT ID was verified at the time
// of the booking. The VIES service can change its
// answer over time (e.g. a company deregisters),
// but the historical check is fixed.
//
// Polymorphic on entityType + entityId so the same
// log can hold both Customer and Supplier checks
// (and Invoice-level re-checks at booking time).
model VatValidationLog {
  id            String   @id @default(uuid())
  companyId     String
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // 'customer' or 'supplier' (extensible).
  // The (entityType, entityId) pair is the
  // "who got validated" pointer.
  entityType    String
  entityId      String
  // The VAT ID we asked VIES to verify. Stored
  // alongside the result because the underlying
  // entity's vatId might change later — we want
  // to know "on 2026-06-15, customer X was
  // validated as DE123456789" even if the customer
  // has since been edited.
  vatId         String
  // ISO 3166-1 alpha-2 country code extracted
  // from the VAT ID prefix (e.g. "DE" from
  // "DE123456789"). VIES requires both pieces.
  countryCode   String

  // 'valid' | 'invalid' | 'unreachable' | 'pending'.
  // pending = queued but not yet hit VIES (we
  // usually store this only for in-flight calls
  // and never persist it; the row is replaced
  // when the call completes).
  status        String

  // VIES returns the company name + address as
  // part of a valid response. Storing them lets
  // the user cross-check against their own
  // customer/supplier data — discrepancies are
  // a common red flag (typing error in the
  // customer record).
  viesName      String?
  viesAddress   String?

  // Error detail for 'invalid' / 'unreachable'.
  // 'invalid' → "MS_UNAVAILABLE" (member-state
  // service offline), "INVALID_FORMAT",
  // "UNKNOWN_VAT" (VIES says no such VAT ID
  // exists). 'unreachable' → network / timeout
  // to ec.europa.eu.
  errorCode     String?
  errorMessage  String?

  // When the call completed. NULL while pending.
  // We use this to decide cache validity — a
  // valid result older than 30 days is
  // considered stale and re-checked on the next
  // user action.
  checkedAt     DateTime?

  // Latency for the VIES call. Useful for
  // diagnosing VIES outages / slowness.
  durationMs    Int?

  createdAt     DateTime @default(now())

  @@index([companyId, entityType, entityId])
  @@index([vatId])
  @@index([createdAt])
}

// Per-company mail (SMTP) configuration. If no row exists, falls back to env vars.
model MailConfig {
  id            String   @id @default(uuid())
  companyId     String   @unique
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  smtpHost      String
  smtpPort      Int      @default(587)
  smtpSecure    Boolean  @default(false)
  smtpUser      String
  smtpPassword  String   // stored as-is; not encrypted at this layer (TODO: KMS)
  fromName      String
  fromEmail     String
  enabled       Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model EmailSend {
  id              String    @id @default(uuid())
  companyId       String
  company         Company   @relation(fields: [companyId], references: [id])
  invoiceId       String?
  invoice         Invoice?  @relation(fields: [invoiceId], references: [id])
  templateType    String?
  recipientEmail  String
  recipientName  String?
  subject         String?
  bodyPreview     String?
  attachmentPaths Json?
  status          String    @default("opened")
  sentAt          DateTime?
  notes           String?
  createdById     String?
  createdBy       User?     @relation(fields: [createdById], references: [id])
  createdAt       DateTime  @default(now())

  @@index([companyId, invoiceId])
  @@index([createdAt])
}

// Webhook — outbound HTTP callback when a
// business event happens. We use this to
// integrate with DATEV, sevDesk, lexoffice,
// Zapier, Make, n8n, or a custom internal
// system. Each webhook subscribes to one
// or more event types (e.g. "invoice.created",
// "payment.received"); when the event fires,
// we POST a JSON payload to the URL with an
// HMAC-SHA256 signature in the X-Signature
// header (so the receiver can verify the
// request really came from us).
//
// Status lifecycle:
//   active   — receiving events normally
//   paused   — disabled by an admin (e.g.
//              receiver is down for maintenance)
//   disabled — soft-deleted (kept for audit
//              trail of past deliveries)
//
// We keep the signing secret in the DB
// (not in env vars) so each company can
// rotate their secrets independently. The
// secret is shown in the response ONCE on
// create (the user is told "save this
// somewhere — we won't show it again").
model Webhook {
  id            String    @id @default(uuid())
  companyId     String
  company       Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name          String    // human-readable, e.g. "DATEV connector"
  url           String    // the receiver endpoint
  // Secret used to sign the request body
  // (X-Signature: sha256=<hex>). The receiver
  // recomputes the HMAC over the raw body and
  // compares. The secret is generated by the
  // server (32 random bytes, base64url) and
  // shown to the user ONCE on create. It is
  // never returned by GET endpoints.
  secret        String
  // List of event types this webhook
  // subscribes to. JSON array stored as
  // string for portability. Example:
  //   ["invoice.created", "invoice.paid",
  //    "payment.received"]
  events        String
  // active | paused | disabled
  status        String    @default("active")
  // Optional description / notes
  description   String?
  createdById   String?
  createdBy     User?     @relation("WebhookCreator", fields: [createdById], references: [id])
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  deliveries    WebhookDelivery[]

  @@index([companyId, status])
  @@index([createdAt])
}

// WebhookDelivery — one row per delivery
// attempt. Records: which webhook, which
// event, the response code + body, and
// timing. Failures are recorded with the
// error message; the retry policy is
// "5xx or network error → retry 3 times
// with exponential backoff" (see
// webhook.service.ts).
//
// We do NOT remove rows on retry; the
// history is valuable for debugging
// "why is my integration missing
// invoice.created events from
// last Tuesday at 14:32?" — the receiver
// may have had an outage.
model WebhookDelivery {
  id            String    @id @default(uuid())
  webhookId     String
  webhook       Webhook   @relation(fields: [webhookId], references: [id], onDelete: Cascade)
  companyId     String
  eventType     String    // e.g. "invoice.created"
  eventId       String    // e.g. "inv_8c6a9669-..." — a stable id the receiver can dedupe on
  payload       Json      // the exact body that was POSTed (or attempted to)
  // HTTP response from the receiver.
  // statusCode=null means we never got
  // a response (network error or timeout).
  statusCode    Int?
  responseBody  String?   // truncated to 4KB
  // Latency in ms (from POST send to
  // response receive / timeout).
  durationMs    Int?
  // One of: pending | success | failed |
  // exhausted (all retries failed). A
  // failed delivery may be retried (see
  // retryCount).
  status        String    @default("pending")
  retryCount    Int       @default(0)
  errorMessage  String?
  attemptedAt   DateTime  @default(now())
  nextRetryAt   DateTime? // set when status='failed' and a retry is scheduled

  @@index([webhookId, attemptedAt])
  @@index([eventType, eventId])  // dedupe
  @@index([status, nextRetryAt]) // for the retry worker
}

// Attachment — uploaded files linked to an Expense or
// Voucher. Carries the original filename, MIME type,
// file size, storage path, and (for PDFs and text-
// extractable files) the OCR text. The actual file
// bytes live on disk under ~/data/invoice-system/
// attachments/<companyId>/<uuid>.<ext> (see
// StorageService). The relation to Expense / Voucher
// is polymorphic via entityType + entityId — the
// dedicated FK columns are kept (not the Json array)
// so the relations surface in the Prisma client with
// proper typing and so a JOIN can fetch attachments
// in a single round-trip.
model Attachment {
  id            String   @id @default(uuid())
  companyId     String
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // 'expense' or 'voucher' (extensible to 'invoice' later
  // for outbound invoices — the Belegfluss / audit
  // requirement applies to all bookkeeping-relevant
  // documents, not just incoming ones).
  entityType    String
  entityId      String

  // Original filename as uploaded (used for download
  // Content-Disposition). NOT the storage path —
  // see `storagePath` for that.
  originalName  String
  // MIME type — used for Content-Type on download and
  // for the icon in the UI. Detected server-side from
  // the magic bytes (see storage.service.ts), not
  // trusted from the client.
  mimeType      String
  // File size in bytes — surfaced in the list and
  // used to enforce the 10MB upload limit.
  size          Int
  // Path on disk, relative to the storage base dir.
  // Format: "<companyId>/<uuid>.<ext>". The
  // StorageService joins with the base path to get
  // the absolute path. We don't store the absolute
  // path because the base dir is configurable.
  storagePath   String

  // OCR text — extracted automatically for PDFs
  // (via pdf-parse) and for JPEG/PNG (a future
  // Tesseract integration will populate this; for
  // now it stays null for images). Max 200k chars
  // to keep the row small — longer files get
  // truncated with a trailing "…[truncated]" marker.
  ocrText       String?
  // Hash of the file content (SHA-256, hex) — used
  // to detect duplicates and to bind the audit
  // trail to the exact bytes that were stored. GoBD
  // §147 AO requires the integrity of the original
  // document to be provable.
  contentHash   String

  // Optional: who uploaded. Stamped by the controller
  // from x-user-id. Null for system-attached files
  // (e.g. the PDF generated by the invoice module).
  uploadedById  String?
  uploadedBy    User?   @relation("UploadedAttachments", fields: [uploadedById], references: [id])

  // Tier 79: back-relation from BeraterNote. An
  // Attachment used as a Berater note's supporting
  // doc is still "expense" / "voucher" / etc. in
  // entityType — the BeraterNote is the
  // presentation layer on top. A given Attachment
  // can back multiple BeraterNotes (one Beleg
  // could be referenced by two notes on the same
  // record), so the back-relation is many-to-one.
  beraterNotes  BeraterNote[]

  createdAt     DateTime @default(now())

  @@index([companyId, entityType, entityId])
  @@index([contentHash])
}

model AuditLog {
  id          String    @id @default(uuid())
  companyId   String?
  company     Company?  @relation(fields: [companyId], references: [id])
  userId      String?
  user        User?    @relation(fields: [userId], references: [id])
  action      String
  entityType  String?
  entityId    String?
  oldData     Json?
  newData     Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())
  // Tier 196 — tamper-evident hash chain.
  // `hash` is the SHA-256 of a canonical string of
  // the row's content plus `previousHash`. The
  // first row in a chain has previousHash = ''.
  // The algorithm identifier leaves room for a
  // future format migration without breaking the
  // verify path. We use `algorithm: SHA-256-V1`
  // matching the CashBook Tier 194 convention
  // so the verify tool is the same shape.
  //
  // Any post-hoc mutation of a row (oldData / newData
  // / action / entityId) makes the recomputed hash
  // diverge from the stored one. Any row deletion
  // breaks the chain at the deletion point. Any
  // row insertion in the middle of the chain
  // breaks the subsequent rows' previousHash
  // pointers. The verify endpoint walks the
  // chain in createdAt order and surfaces the
  // first mismatch.
  hash          String?
  previousHash  String?
  hashAlgorithm String?

  @@index([companyId, createdAt])
  @@index([entityType, entityId])
}

/// Tier 79: Berater Document Exchange — the
/// write-back channel from a Steuerberater
/// (role='berater' on UserCompany) to the
/// Mandant. Tier 66 + 71 gave the Berater
/// read access; this tier adds the
/// counterpart — the Berater can leave notes
/// + upload supporting documents (Belege,
/// Korrekturen) on specific records (an
/// invoice, an expense, a voucher, etc.) and
/// the Mandant sees them in a queue and can
/// acknowledge or dismiss.
///
/// The Berater does NOT get write access to
/// the underlying bookkeeping data — only to
/// this dedicated "berater" namespace. A
/// note is a suggestion + supporting doc, not
/// a mutation. The Mandant acts on it (or
/// not) in the normal application UI.
///
/// Lifecycle: open → acknowledged | dismissed.
/// A note stays in the list until the
/// Mandant moves it. We keep the dismissed
/// notes visible (with status='dismissed')
/// so the Berater can see "yep, the Mandant
/// saw it and chose not to act" — important
/// for the audit trail.
/// Tier 79: Berater Document Exchange — the
/// write-back channel from a Steuerberater
/// (role='berater' on UserCompany) to the
/// Mandant. Tier 66 + 71 gave the Berater
/// read access; this tier adds the
/// counterpart — the Berater can leave notes
/// + upload supporting documents (Belege,
/// Korrekturen) on specific records (an
/// invoice, an expense, a voucher, etc.) and
/// the Mandant sees them in a queue and can
/// acknowledge or dismiss.
///
/// The Berater does NOT get write access to
/// the underlying bookkeeping data — only to
/// this dedicated "berater" namespace. A
/// note is a suggestion + supporting doc, not
/// a mutation. The Mandant acts on it (or
/// not) in the normal application UI.
///
/// Lifecycle: open -> acknowledged | dismissed.
/// A note stays in the list until the
/// Mandant moves it. We keep the dismissed
/// notes visible (with status='dismissed')
/// so the Berater can see "yep, the Mandant
/// saw it and chose not to act" — important
/// for the audit trail.
model BeraterNote {
  id           String   @id @default(uuid())
  companyId    String
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  // The record the note is about. No DB-level
  // FK because the entityType vocabulary spans
  // many tables (invoice / expense / voucher /
  // customer / …). The list endpoint + the
  // frontend surface (entityType, entityId) so
  // the Mandant can click through to the
  // referenced record.
  entityType   String
  entityId     String
  // Optional attachment (a corrected Beleg, a
  // signed letter, a screenshot of the FA
  // reply). Reuses the Attachment model so the
  // file is stored + downloadable via the same
  // path as every other file in the app. ON
  // DELETE SET NULL: deleting the file row
  // preserves the note (the text survives, the
  // attachment just disappears from it).
  attachmentId String?
  attachment   Attachment? @relation(fields: [attachmentId], references: [id], onDelete: SetNull)
  // Free-form text. Required. The controller
  // enforces min 1 char + max 4 KB (a long
  // explanation should be its own doc).
  message      String
  // 'open' (new, Mandant hasn't acted) |
  // 'acknowledged' (Mandant saw + confirmed) |
  // 'dismissed' (Mandant saw + chose not to act)
  status       String   @default("open")
  // The Berater who wrote the note. Must have
  // role='berater' on the UserCompany for this
  // companyId (enforced at the controller, not
  // here — the model doesn't know about roles).
  createdById  String
  createdBy    User     @relation("BeraterNoteCreatedBy", fields: [createdById], references: [id])
  createdAt    DateTime @default(now())
  // Acknowledgement — the Mandant (or any user
  // with non-berater role on the same
  // UserCompany) confirms they've seen the note.
  // We capture who + when for audit.
  acknowledgedById String?
  acknowledgedBy   User?   @relation("BeraterNoteAcknowledgedBy", fields: [acknowledgedById], references: [id])
  acknowledgedAt   DateTime?
  // Dismissal — the Mandant saw the note but
  // chose not to act. Same capture pattern.
  dismissedById String?
  dismissedBy   User?   @relation("BeraterNoteDismissedBy", fields: [dismissedById], references: [id])
  dismissedAt   DateTime?

  @@index([companyId, status, createdAt])
  @@index([entityType, entityId])
  @@index([createdById, createdAt])
}

/// Captured runtime errors from both the backend (uncaught
/// exceptions, manually logged via ErrorTrackingService) and
/// the frontend (uncaught browser errors + React error
/// boundary events). Frontend posts via
///   POST /api/v1/system/errors { message, stack, source, ... }
/// Backend auto-captures via a global NestJS exception
/// filter (system.filter.ts) so every unhandled error in
/// any route gets here without per-module try/catch boilerplate.
///
/// The "self-hosted Sentry" pattern:
///   - cheap to query (just SELECT from Postgres)
///   - no 3rd-party SaaS / no PII leaking
///   - dashboard table at /dashboard/system-errors
///   - retention: 30 days (admin can prune via /prune)
model ErrorEvent {
  id          String   @id @default(uuid())
  /// 'backend' = unhandled NestJS exception OR service.logError()
  /// 'frontend' = window.onerror / unhandledrejection / ErrorBoundary
  source      String
  /// JS error message, e.g. "Cannot read properties of null (reading 'id')"
  message     String
  /// First 4 KB of the stack trace. PDFKit stacks can run
  /// 50+ frames deep; truncating keeps the row small and
  /// the column under Postgres' toast threshold.
  stack       String?
  /// Free-form context, e.g. {url, userId, companyId,
  /// browser, component, level}. JSONB so the schema can
  /// grow without migrations.
  context     Json?
  /// 'unhandled' | 'boundary' | 'manual' | 'api'
  kind        String   @default("unhandled")
  /// Same event from same source within 5 min = dedupe,
  /// incremented instead of inserting a new row. Lets the
  /// /dashboard/system-errors view show "1 error × 42 times"
  /// rather than 42 rows.
  occurrences Int      @default(1)
  /// 'open' = needs attention. 'resolved' = admin marked
  /// it. 'muted' = filtered noise (e.g. a noisy script
  /// 404 we want to ignore). Filtered in /system-errors
  /// view by default.
  status      String   @default("open")
  /// SHA-256 of (source + message + first stack frame) for
  /// dedupe. Indexed.
  fingerprint String
  /// Optional — for backend events we can capture who
  /// was logged in when the error fired. NULL for
  /// pre-auth errors (login, registration) and for any
  /// uncaught startup exception.
  userId      String?
  user        User?    @relation(fields: [userId], references: [id])
  companyId   String?
  company     Company? @relation(fields: [companyId], references: [id])
  /// URL of the API route that threw (backend) or the
  /// page the user was on (frontend).
  url         String?
  /// HTTP method for backend API errors; null for frontend.
  method      String?
  /// HTTP status code for backend API errors; null for frontend.
  statusCode  Int?
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())
  resolvedAt  DateTime?
  resolvedBy  String?

  @@index([fingerprint])
  @@index([source, lastSeenAt])
  @@index([companyId, lastSeenAt])
  @@index([status, lastSeenAt])
}

/// Per-company customizable reminder (Mahnung) templates.
/// One row per (companyId, level) tuple; level ∈ {first, second, final}.
/// Both subject and body are templates with `{{...}}` placeholders
/// resolved at send time — see reminder.service.renderTemplate().
/// Defaults are seeded on first request via getOrCreateDefaults().
model ReminderTemplate {
  id         String   @id @default(uuid())
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  level      String   // "first" | "second" | "final"
  subject    String   @db.Text
  body       String   @db.Text
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([companyId, level])
  @@index([companyId])
}

/// Tier 156: per-company Bemerkungstext (notes) templates
/// the operator can drop into the invoice-create form.
///
/// Mirrors the ReminderTemplate pattern (per-company, free-
/// text, soft-default via isDefault). The first GET seeds
/// five German defaults if the company has no templates yet
/// — the same convention the Mahnung-Vorlagen editor uses.
///
/// Why a separate model and not a JSON column on Company:
///   1. The list is editable through the UI; the operator
///      can add, rename, delete, and re-order entries.
///      That's a list of rows, not a single JSON blob.
///   2. Each row has its own audit trail (createdAt /
///      updatedAt) so the dashboard can show "letzte
///      Änderung" without parsing JSON.
///   3. Future-proof: if we ever ship per-customer
///      templates (e.g. a B2B customer wants their
///      Bestellnummer on every invoice), the FK is already
///      in the right shape.
model NoteTemplate {
  id         String   @id @default(uuid())
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  label      String   // short button label, e.g. "Skonto 2%"
  text       String   @db.Text
  sortOrder  Int      @default(0)
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([companyId, sortOrder])
}

/// Mahnung audit trail (Tier 37).
///
/// One row per Mahnung email/PDF that went out. Distinct
/// from EmailSend so the dunning-specific fields (level,
/// daysOverdue at send-time, the Mahngebühr + Verzugszins
/// charged at THIS level) can travel with the row and be
/// queried easily for the dashboard / for the
/// "Mahnhistorie" view the user sees in the UI.
///
/// Why a separate table:
///   1. Fast list (`/reminders?invoiceId=…` returns the
///      dunning history without joining into EmailSend's
///      multi-purpose rows).
///   2. Holds the money: late interest (§288 BGB) and the
///      per-level Mahngebühr that were charged on THIS
///      letter. The total charged + the running balance
///      are derived from these rows.
///   3. Supports cancel() — `cancelledAt` flips without
///      touching the EmailSend row (which is still useful
///      for "send log" display in the dashboard).
///
/// `daysOverdue` is captured at send-time so the row is
/// self-describing even if the underlying invoice later
/// gets paid or extended.
///
/// `cancelledAt` is set when:
///   - admin explicitly cancels the Mahnung (`/reminders/:id/cancel`)
///   - the invoice is fully paid (payment.service
///     cascade-cancels all open Mahnungen on the invoice).
///   A cancelled Mahnung remains in the table — it's an
///   audit row, not a wishlist.
model Mahnung {
  id          String   @id @default(uuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  /// "first" | "second" | "final" — same vocabulary as
  /// ReminderTemplate.level so the two tables don't drift.
  level       String
  /// Calendar days overdue at send-time. The PDF shows
  /// Werktage too — see auto-reminder.scheduler.ts — but
  /// we keep daysOverdue here for the dashboard badge.
  daysOverdue Int
  /// The new payment deadline the Mahnung sets. ISO
  /// date string. The PDF prints it as dd.mm.yyyy.
  neueFrist   DateTime
  /// The Mahngebühr charged on this Mahnung (in EUR).
  /// Level-driven (0 / 2.50 / 5.00 typically) — see
  /// getOrCreateFeeConfig().
  mahngebuehr Decimal  @db.Decimal(12,4) @default(0)
  /// Verzugszins charged on this Mahnung (in EUR, computed
  /// from invoice total * (verzugszinsPct/100) * (days/
  /// 365)). The percentage is company-level — see
  /// Company.bankInfo.lateInterestPct (default 9.0 per
  /// §288 Abs. 2 BGB for B2B).
  verzugszins Decimal  @db.Decimal(12,4) @default(0)
  /// The total amount NOW DUE on this Mahnung = invoice
  /// open balance + mahngebuehr + verzugszins. Snapshot.
  totalDue    Decimal  @db.Decimal(12,4)

  /// Snapshot of the recipient — already on EmailSend but
  /// duplicated here so the list view doesn't need a join.
  recipientEmail String
  recipientName  String?

  /// Who triggered the send (admin user id). Null for
  /// cron-driven sends.
  sentById    String?
  /// Filled by the manual route when the email actually
  /// went out. The manual PDF generation is synchronous —
  /// we set sentAt before returning the 200 to the client.
  sentAt      DateTime @default(now())
  /// The EmailSend templateType ("reminder_first" | etc.)
  /// for traceability back to the actual email log row.
  emailSendId String?

  /// Soft-cancel marker. When set, the Mahnung is no
  /// longer active (either by admin action or because the
  /// invoice was paid). The PDF stays accessible for the
  /// audit trail — we don't delete anything.
  cancelledAt    DateTime?
  cancelledById  String?
  cancelReason   String?

  createdAt   DateTime @default(now())

  @@index([companyId, invoiceId])
  @@index([companyId, sentAt])
  @@index([companyId, cancelledAt])
  @@index([level])
}

/// Recurring invoice (Abo-Rechnung) template. The scheduler
/// reads `nextRunAt` daily and materialises a new Invoice
/// (linked via `recurringInvoiceId`) when today ≥ nextRunAt
/// and `isActive=true`. The snapshot of line items lives in
/// `RecurringInvoiceItem` so editing the template doesn't
/// retroactively rewrite already-sent invoices.
model RecurringInvoice {
  id            String   @id @default(uuid())
  companyId     String
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customerId    String
  customer      Customer @relation(fields: [customerId], references: [id])
  // human label for the subscription, e.g. "Wartungsvertrag 2026"
  name          String
  // monthly / quarterly / yearly / weekly
  interval      String
  // interval count: 1 = every month, 2 = every 2 months, etc.
  intervalCount Int      @default(1)
  // The day-of-month the invoice should be issued. For
  // monthly: 1-28 (clamped at 28 to avoid 31st-on-30th-month
  // surprises). Ignored for weekly.
  dayOfMonth    Int      @default(1)
  // First day this template is allowed to generate. The
  // scheduler uses max(startDate, lastRunAt + interval).
  startDate     DateTime
  // Optional end. Once nextRunAt > endDate, the template
  // auto-disables (isActive=false) and won't fire again.
  endDate       DateTime?
  // nextRunAt is updated on every successful run. Compared
  // against "today" in the cron tick.
  nextRunAt     DateTime
  lastRunAt     DateTime?
  // Currency + language snapshot. (Most templates stick
  // to EUR / de-DE; the field is here for completeness.)
  currency      String   @default("EUR")
  language      String   @default("de-DE")
  // Free-text notes copied to every generated invoice.
  notes         String?
  // Default status of generated invoices. "draft" leaves
  // the user to review; "sent" marks them ready immediately.
  invoiceStatus String   @default("draft")
  // Paused templates don't fire. UI toggles this when the
  // customer pays ahead, the contract is on hold, etc.
  isActive      Boolean  @default(true)
  // Tier 153: time-bounded pause. The scheduler
  // skips templates where today < pausedUntil.
  // The UI resumes the template automatically
  // once pausedUntil is in the past (we don't
  // auto-flip isActive, but the next GET shows
  // the effective state as 'active' again).
  // NULL = not paused-by-date. The full pause
  // flag is isActive=false.
  pausedUntil   DateTime?
  // Tier 129: when true, the scheduler emails the
  // generated invoice to the customer's contact.email
  // via the same path as the manual "Per E-Mail senden"
  // button on the invoice detail page. Default true
  // because the user explicitly opted into recurring
  // generation — they want the customer to see it.
  // Operators can disable per-template for "internal
  // draft" use cases (e.g. a subscription that the
  // billing team reviews before sending).
  sendEmail     Boolean  @default(true)
  createdById   String?
  createdBy     User?    @relation("RecurringCreator", fields: [createdById], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  items   RecurringInvoiceItem[]
  runs    RecurringRun[]
  invoices Invoice[]

  @@index([companyId, isActive, nextRunAt])
  @@index([customerId])
}

/// Snapshot of one line item on a RecurringInvoice. The
/// per-run Invoice copies these into InvoiceItem at
/// generation time — so later edits to the template only
/// affect future invoices, not already-issued ones.
model RecurringInvoiceItem {
  id                String   @id @default(uuid())
  recurringInvoiceId String
  recurringInvoice  RecurringInvoice @relation(fields: [recurringInvoiceId], references: [id], onDelete: Cascade)
  description       String
  productNumber     String?
  quantity          Decimal  @db.Decimal(12, 4)
  unit              String?  @default("Stück")
  unitPrice         Decimal  @db.Decimal(12, 4)
  vatRate           Decimal  @db.Decimal(5, 4)
  // Sort order so reordering the UI rows works without
  // relying on insert-order (Postgres doesn't guarantee
  // that for ties).
  position          Int      @default(0)

  @@index([recurringInvoiceId])
}

/// History log of every run the scheduler (or manual
/// trigger) executed. `success=false` rows record the
/// error message so the user can see WHY a run failed.
model RecurringRun {
  id                String   @id @default(uuid())
  recurringInvoiceId String
  recurringInvoice  RecurringInvoice @relation(fields: [recurringInvoiceId], references: [id], onDelete: Cascade)
  companyId         String
  company           Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  // "scheduled" (cron) or "manual" (button on the UI)
  trigger           String
  // The intended period start. For monthly: 1st of the
  // month; for quarterly: 1st of the quarter month, etc.
  periodStart       DateTime
  periodEnd         DateTime
  // The invoice this run materialised. NULL on failure.
  invoiceId         String?
  invoice           Invoice? @relation(fields: [invoiceId], references: [id])
  // "success" | "failed" | "skipped" (e.g. endDate in past)
  status            String
  errorMessage      String?
  createdAt         DateTime @default(now())

  @@index([recurringInvoiceId, periodStart])
  @@index([companyId, status])
  // Idempotency: the same template can never have two
  // runs for the same periodStart. A duplicate insert
  // (from a parallel cron tick) raises a P2002, which
  // the service catches and treats as "already ran".
  @@unique([recurringInvoiceId, periodStart])
}

/// Tier 64: Mahnungspause (reminder pause).
///
/// A pause excludes an invoice (or every invoice of a
/// customer) from `ReminderService.findOverdueInvoices`
/// for a defined window. Use cases:
///   - Customer is on an InstallmentPlan (Ratenplan) —
///     the schedule handles dunning; we shouldn't pile
///     Mahnungen on top.
///   - Customer disputed the invoice and an out-of-band
///     resolution is in flight.
///   - Berater knows the customer will pay next week
///     and wants to skip this week's Mahnung.
///
/// Either `customerId` OR `invoiceId` is set (not
/// both, not neither). The pause is active when
/// `now` is in [pausedFrom, pausedUntil]. If
/// `pausedUntil` is NULL, the pause is open-ended —
/// the Berater must close it explicitly (DELETE
/// or PATCH pausedUntil).
///
/// `cancelledAt` is the soft-cancel stamp. When the
/// user "ends" a pause early, we set cancelledAt =
/// now() and keep the row for audit (same pattern as
/// Mahnung.cancelledAt — GoBD-relevant).
///
/// Index strategy: (companyId, customerId) and
/// (companyId, invoiceId) so the reminder filter can
/// do `WHERE customerId IN (...) AND active=true`
/// in O(1) without a table scan.
model Mahnungspause {
  id           String   @id @default(uuid())
  companyId    String
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customerId   String?
  customer     Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  invoiceId    String?
  invoice      Invoice? @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  /// Free-text reason: "Ratenplan läuft bis 2026-12",
  /// "Kunde bestreitet Forderung", "Manuell".
  reason       String
  /// Start of the pause (inclusive). Defaults to "now"
  /// at create time. User can backdate if the dispute
  /// started last week.
  pausedFrom   DateTime
  /// End of the pause (inclusive). NULL = open-ended.
  pausedUntil  DateTime?
  /// Soft-cancel stamp. When the user "ends" a pause
  /// early, we set this and keep the row for audit.
  cancelledAt  DateTime?
  createdById  String?
  createdBy    User?    @relation(fields: [createdById], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([companyId, customerId])
  @@index([companyId, invoiceId])
  @@index([companyId, cancelledAt])
}

/// Kassenbuch — German cash journal per §146 AO.
///
/// Every cash movement (Einnahme / Ausgabe / Umbuchung
/// between cash and bank) is a row here. The cash book
/// is GoBD-relevant: once a Tagesabschluss has been
/// recorded, the entries of that day can no longer be
/// edited — corrections must be made as a new Storno-
/// Buchung that negates the original amount.
///
/// The schema separates the immutable book (CashBookEntry)
/// from the day-end snapshot (CashBookDailyClose). The
/// daily close captures Anfangsbestand + ΣEinnahmen +
/// ΣAusgaben = Endbestand at the moment of closing, and
/// is the value the Berater / auditor compares against
/// the physical cash count (Kassensturz).
model CashBookEntry {
  id           String   @id @default(uuid())
  companyId    String
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  // The business date the entry belongs to, not the
  // timestamp of when the row was written. Cash book
  // entries are dated by transaction date (Belegdatum)
  // — a receipt dated 28.01 still lands in the 28.01
  // daily close, even if you type it in on 02.02.
  businessDate DateTime @db.Date
  // "einnahme" | "ausgabe" | "umbuchung" | "eroeffnung"
  // (Anfangsbestand, one per cash book lifetime).
  type         String
  // Free-text description. Required by §22 UStG.
  description  String
  // Gross amount in EUR, always positive. The type
  // column decides whether the cash balance increases
  // or decreases.
  amount       Decimal  @db.Decimal(12, 4)
  // Optional VAT rate (0 / 0.07 / 0.19). When non-zero
  // the entry counts as a taxable movement for the
  // UStVA. Net amount is derived: amount / (1 + rate).
  vatRate      Decimal? @db.Decimal(5, 4)
  // Counterparty: customer or supplier, optional. We
  // don't FK-restrict (cash from anonymous walk-ins is
  // perfectly legal) but the field is denormalised for
  // audit reporting.
  counterparty String?
  // Receipt / voucher number, e.g. "Bon-2026-00123".
  // Free-form, not unique — the same number across
  // two years is fine, and the user can leave it
  // blank for petty cash.
  belegNumber  String?
  // FK to Expense when this entry was created from an
  // expense bookkeeping (optional). For an Ausgabe the
  // user can promote the entry to a booked Expense.
  expenseId    String?
  expense      Expense? @relation(fields: [expenseId], references: [id])
  // FK to Invoice when this entry was created from an
  // invoice payment (Barzahlung at the counter).
  invoiceId    String?
  invoice      Invoice? @relation(fields: [invoiceId], references: [id])
  // ISO 4217 — EUR for the German market. The column
  // is here so multi-currency can be added later.
  currency     String   @default("EUR")
  // Set when this entry is a Storno / reversal of
  // another entry. The original stays in the book;
  // the Storno just nets the effect to zero. Reversal
  // is the only way to "edit" a closed day.
  reversesId   String?  @unique
  reverses     CashBookEntry? @relation("CashBookReversal", fields: [reversesId], references: [id])
  reversedBy   CashBookEntry? @relation("CashBookReversal")
  // Free-form notes (1-2 lines), e.g. reason for
  // a correction, receipt scan reference, etc.
  notes        String?
  createdById  String?
  createdBy    User?    @relation("CashBookEntryCreator", fields: [createdById], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([companyId, businessDate])
  @@index([companyId, type])
}

/// Tagesabschluss (Z-Bericht) — snapshot of the cash
/// position at end-of-day. Written once and treated as
/// immutable per GoBD §146 AO Abs. 4. The
/// `entriesSnapshot` is a JSON copy of every entry id +
/// amount that was on the book at close-time, so a
/// later audit can replay the close without re-running
/// the SUM aggregate (which would be wrong if any
/// Storno on the closed day has been added since).
model CashBookDailyClose {
  id              String   @id @default(uuid())
  companyId       String
  company         Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  // The day being closed. Unique per company — a day
  // can only be closed once. (Re-open = delete this
  // row, which the service does explicitly with audit
  // logging.)
  businessDate    DateTime @db.Date @unique
  // Cached aggregates at close-time. Re-computed on
  // read by the service if the snapshot looks stale.
  anfangsbestand  Decimal  @db.Decimal(12, 4)
  einnahmenSum    Decimal  @db.Decimal(12, 4)
  ausgabenSum     Decimal  @db.Decimal(12, 4)
  umbuchungenSum  Decimal  @db.Decimal(12, 4)
  endbestand      Decimal  @db.Decimal(12, 4)
  // The physical count of cash in the till. The user
  // types this in at Z-Bericht time. Diff vs.
  // endbestand is the "Differenz" (Kassensturz-
  // Differenz) — usually 0.00, but a small positive
  // means Mehrbestand (over) and negative means
  // Fehlbestand (shortage / Diebstahl).
  physicalCount   Decimal  @db.Decimal(12, 4)
  differenz       Decimal  @db.Decimal(12, 4)
  // Free-text note for non-zero differs ("Differenz
  // aufgeklärt: Bon vergessen, Beleg folgt").
  differenzNote   String?
  // Snapshot of all entry ids on this date at close
  // time. Format: { entries: [{id, type, amount, vatRate,
  // description}], totalCount: N }. Used for audit
  // replay — even after Storno entries are added, the
  // close still shows the original (pre-Storno) state.
  entriesSnapshot Json
  // Set when a Storno / reversal entry has been added
  // AFTER close-time. The close itself stays valid;
  // this flag tells the UI to surface "this day has
  // been amended since close" instead of treating the
  // numbers as final.
  amendedAt       DateTime?
  // User who closed the day + their comment, if any.
  closedById      String?
  closedBy        User?    @relation("CashBookDayCloser", fields: [closedById], references: [id])
  closedAt        DateTime @default(now())
  // ─── Tier 194 — GoBD § 146 AO integrity signature ───
  // SHA-256 hash of the close record's critical fields
  // (companyId|businessDate|anfangsbestand|einnahmenSum|
  //  ausgabenSum|umbuchungenSum|endbestand|physicalCount|
  //  closedById|closedAt). Computed at close-time and
  // also at sign-time (the sign endpoint re-derives
  // the hash from the current row state and asserts
  // equality — any post-close mutation makes the
  // re-derived hash diverge from the stored one, so
  // the user can detect tampering).
  //
  // This is NOT an eIDAS-qualified electronic
  // signature. It's a tamper-evident integrity hash
  // for the internal audit trail. A separate
  // eIDAS/PKI signature could be added later in
  // the same field (extending the algorithm
  // string) without breaking existing data.
  signatureHash       String?
  signatureAlgorithm  String?
  signatureTimestamp  DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([companyId, businessDate])
}

//
// One uploaded bank statement file (MT940 SWIFT or
// CAMT.053 SEPA XML). Holds the raw file content for
// re-parse if the parser improves, plus basic metadata
// extracted at upload time (bank name, statement period,
// opening / closing balance).

model BankStatement {
  id              String   @id @default(uuid())
  companyId       String
  company         Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  // 'mt940' (SWIFT) or 'camt053' (SEPA XML)
  format          String
  fileName        String
  fileSize        Int
  // Optional IBAN of the account this statement is for
  accountIban     String?
  // The bank the statement came from (parsed from the
  // header — :25: in MT940 / BkToCstmrStmt/BkNm in CAMT).
  bankName        String?
  // Statement period (start..end dates).
  periodFrom      DateTime?
  periodTo        DateTime?
  // Opening + closing balance in EUR.
  openingBalance  Decimal? @db.Decimal(12, 4)
  closingBalance  Decimal? @db.Decimal(12, 4)
  // Raw text of the file, kept for audit / re-parse.
  rawContent      String
  uploadedById    String?
  uploadedBy      User?    @relation("BankStatementUploader", fields: [uploadedById], references: [id])
  createdAt       DateTime @default(now())

  transactions BankTransaction[]

  @@index([companyId, createdAt])
  @@index([companyId, format])
}

//
// One transaction line parsed out of a bank statement.
// Independent of Invoice — reconciliation is a separate
// `BankReconciliation` join row, so a single payment
// can be matched to multiple invoices (overpayment) and
// a single invoice can be matched to multiple payments
// (partial payments).

model BankTransaction {
  id              String   @id @default(uuid())
  statementId     String
  statement       BankStatement @relation(fields: [statementId], references: [id], onDelete: Cascade)
  companyId       String
  // The line's value date (Buchungsdatum) — when the
  // money actually moved. Distinct from the entry date
  // (Wertstellung), which we also keep.
  valueDate       DateTime
  entryDate       DateTime?
  // Amount in EUR. Positive = incoming, negative = outgoing.
  amount          Decimal  @db.Decimal(12, 4)
  currency        String   @default("EUR")
  // Counterparty info: name + IBAN if present in the
  // raw line (MT940 :59:, CAMT.053 PmtInf/CdtTrxTxInf).
  counterpartyName String?
  counterpartyIban String?
  // Payment purpose (Verwendungszweck) — typically
  // contains the invoice number / Kunden-Nr. We keep
  // the raw text so the matching logic can do its own
  // regex / fuzzy match.
  purpose         String?
  // End-to-end reference (MT940 :20:, CAMT.053
  // PmtInf/PmtId) — usually a unique bank reference.
  endToEndId      String?
  // Notes the user added after import.
  notes           String?
  // Auto-generated Voucher for an expense booking on
  // this transaction (e.g. debit txn with no matching
  // invoice → book as Aufwand). NULL when the txn
  // either has no booking yet, or the booking is via
  // a BankReconciliation (in which case the voucherId
  // is on the recon row, not on the txn).
  voucherId       String?
  voucher         Voucher? @relation(fields: [voucherId], references: [id])
  createdAt       DateTime @default(now())

  matches BankReconciliation[]

  @@index([statementId])
  @@index([companyId, valueDate])
  @@index([companyId, amount])
}

//
// The many-to-many between a bank transaction and the
// invoice(s) it pays. One transaction can pay multiple
// invoices (overpayment split) and one invoice can be
// paid by multiple transactions (partial payments).
//
// `confidence` is the matcher's self-reported 0-100
// score. Above ~80 the UI offers a "Bestätigen" button
// (writes a Payment + flips invoice to paid); below 80
// the user picks the candidate manually.

model BankReconciliation {
  id              String   @id @default(uuid())
  bankTransactionId String
  bankTransaction BankTransaction @relation(fields: [bankTransactionId], references: [id], onDelete: Cascade)
  invoiceId       String
  invoice         Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  companyId       String
  // How much of the transaction was applied to this invoice
  appliedAmount    Decimal  @db.Decimal(12, 4)
  // 'suggested' (auto-matched, not yet confirmed) /
  // 'confirmed' (user accepted) / 'rejected' (user
  // dismissed)
  status          String   @default("suggested")
  confidence      Int      // 0-100
  // Free-text reason: "amount exact + invoice# in purpose"
  matchReason     String?
  // Auto-generated Voucher for this recon. NULL until
  // the user confirms the match (the confirm flow
  //  books a Bank→Forderung posting so the cash ledger
  // stays in sync with the bank reality). This is the
  // GoBD audit trail — the original raw file is on
  // BankStatement, the parsed transactions on
  // BankTransaction, and the booking on Voucher.
  voucherId       String?
  voucher         Voucher? @relation(fields: [voucherId], references: [id])
  // If the user reopens the match, the original
  // voucherId stays (the original is preserved for
  // GoBD immutability) and a new Storno voucher is
  // written. The Storno id is stored here so the UI
  // can show "BK-XXXX reverted by BK-YYYY" without
  // re-querying the Voucher table.
  reversalVoucherId String?
  reversalVoucher   Voucher? @relation("ReconReversal", fields: [reversalVoucherId], references: [id])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([bankTransactionId, invoiceId])
  @@index([invoiceId, status])
  @@index([companyId, status])
}

// VoucherTemplate — a saved Berater-defined "preset
// Buchungssatz" that the Berater can one-click into
// the manual Voucher modal. Lines carry the accountId
// (the SKR03 chart-of-accounts slot) and an optional
// VAT rate, but NO amount — the amount is filled in
// at apply-time. The template also carries a
// description pattern so the new Voucher's description
// can be auto-filled (e.g. "Bankgebühren <Monat>").
model VoucherTemplate {
  id          String    @id @default(uuid())
  companyId   String
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name        String    // Berater-visible label, e.g. "Bankgebühren"
  description String?   // optional hint
  // The body of the new Voucher, if the user picks
  // "apply template" without overriding. Stored as
  // a JSON list of {accountNumber, debit|credit, vatRate}
  // so a template survives even if the company
  // re-numbers or replaces its Account rows
  // (templates point at accountNumber, not accountId).
  // We resolve accountNumber → accountId at apply time.
  linesJson   String
  // The description pattern to pre-fill the Voucher
  // modal with. Use {month} and {year} placeholders
  // the modal substitutes at apply time.
  descriptionPattern String?
  // Per-company ordering — Berater can drag to
  // re-order; smaller numbers first.
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([companyId, sortOrder])
}

// Tier 48: Cost-Center Budget.
//
// Per-(company, costCenter, year) row carrying 12
// monthly target amounts. The cost-center yearly
// report (tier-44) joins these to render
// budget-vs-actual deltas. The "Nicht zugewiesen"
// pseudo-cost-center maps to a row with costCenter =
// NULL — the API collapses nulls to that bucket on
// read (matches the tier-38/44/45/46 behaviour).
//
// Free-form costCenter string (not FK), mirroring
// Invoice.costCenter / Expense.costCenter. The
// budget is gross net target (positive = revenue
// target, negative = expense cap). Stored as a JSON
// array of 12 decimals to keep schema simple — most
// Berater enter uniform monthly targets, so 12 floats
// is ~250 bytes per row.
model CostCenterBudget {
  id            String   @id @default(uuid())
  companyId     String
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  // Cost-center stamp — same convention as
  // Invoice.costCenter. NULL on the column maps to
  // the "Nicht zugewiesen" pseudo-bucket.
  costCenter    String?
  year          Int      // 2000..2100
  // 12-element array of monthly target amounts
  // (gross). Index 0 = Jan, ..., 11 = Dec.
  // Stored as JSON so we don't need a separate
  // BudgetLine table — the array is small and
  // always read as a unit.
  monthlyTargets Json
  // Optional human label so the Berater can name
  // a budget ("FY2026 Marketing plan") without
  // depending on the costCenter string.
  label         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // One budget per (company, cc, year). NULL cc
  // + same year = unique; "VERTRIEB" + same year =
  // unique. The upsert in the controller relies on
  // this index.
  @@unique([companyId, costCenter, year])
  @@index([companyId, year])
}

// Tier 51: Ratenzahlung — installment payment
// plans for customer invoices. A plan is a 1:1
// attachment to a single Invoice; it splits the
// invoice total into N Raten with a configurable
// interval (default 30 days = monthly). Each Rate
// is tracked individually so the Berater can see
// "what's still open / partial / paid" at a glance
// without scanning the bank-import history.
//
// Money invariants (enforced in the service):
//   sum(Installment.amount) == InstallmentPlan.totalAmount
//   0 <= Installment.paidAmount <= Installment.amount
//
// status is denormalised (derived from paidAmount
// + dueDate vs today) but cached so we can
// index/filter on it for the Mahnung integration.
model InstallmentPlan {
  id                String        @id @default(uuid())
  companyId         String
  company           Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customerId        String
  customer          Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  invoiceId         String        @unique
  invoice           Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  // The Invoice.total that the plan splits up.
  totalAmount       Decimal       @db.Decimal(12,4)
  // Number of Raten — must be >= 2 (single-installment
  // plans are not Raten, they're just a single payment).
  installmentCount  Int
  // Days between Raten. 30 = monthly, 7 = weekly,
  // 90 = quarterly. The service validates the
  // dueDate arithmetic on create.
  intervalDays      Int           @default(30)
  // The first Rate's due date. Subsequent Raten
  // land at firstDueDate + N*intervalDays.
  firstDueDate      DateTime      @db.Date

  // Lifecycle: 'active' (in progress), 'completed'
  // (all Raten paid), 'cancelled' (Ratenplan aborted
  // — Berater voided it). GoBD: we keep cancelled
  // rows for audit, just filter them out of active
  // views.
  status            String        @default("active")
  notes             String?

  installments      Installment[]

  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([companyId, status])
  @@index([customerId, status])
}

// Tier 51: One Rate (single installment) on a
// Ratenplan. Carries the agreed amount + the
// running paid amount + the moment the Rate was
// fully settled.
//
// status is derived on every update (paidAmount +
// dueDate vs now) but cached to make the
// "open installments due this week" dashboard
// query a simple index hit.
model Installment {
  id              String          @id @default(uuid())
  planId          String
  plan            InstallmentPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  // 1-based sequence number within the plan. 1st
  // Rate = 1, 2nd = 2, etc. Stable identifier the
  // user can talk about ("die dritte Rate").
  sequenceNumber  Int
  dueDate         DateTime        @db.Date
  amount          Decimal         @db.Decimal(12,4)
  paidAmount      Decimal         @db.Decimal(12,4) @default(0)
  paidAt          DateTime?

  // Cached lifecycle: 'open' (unpaid and not yet
  // due), 'overdue' (unpaid but dueDate < today),
  // 'partial' (paidAmount > 0 but < amount),
  // 'paid' (paidAmount == amount). The service
  // recomputes this on every paidAmount change
  // AND on a daily cron (tier-36 dashboard) so
  // 'overdue' updates even when no payment lands.
  status          String          @default("open")

  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@unique([planId, sequenceNumber])
  @@index([status, dueDate])
}

// Tier 6: FinTS bank connection. Stores the
// per-company credentials + the (encrypted) PIN
// + the last successful Dialog-Id. Each
// connection is keyed by (companyId, blz, userId)
// — one customer can have multiple accounts at
// different banks. The PIN is stored as a
// sha256 hash (NOT the plaintext) so a database
// leak doesn't give an attacker working creds —
// the hash is what the bank sees as a "fake PIN"
// when it does a probe, and the real PIN is only
// kept in the user's session memory, not in DB.
// For PSD2 Strong Customer Authentication the
// real flow is: user types PIN into the modal,
// we open a one-shot dialog, bank sends a
// HITAN/TAN challenge, user enters the TAN
// in a follow-up modal, we submit and persist
// the resulting system-id + dialog-id for the
// next sync.
model FinTSConnection {
  id              String    @id @default(uuid())
  companyId       String
  company         Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  // 8-digit German Bankleitzahl (e.g. '50050201'
  // for Sparkasse Frankfurt). Stored as text so we
  // don't lose leading zeros.
  blz             String
  // The online-banking user ID (varies per bank:
  // Sparkasse = the VR-NetKey, DKB = the
  // Anmeldename, comdirect = Zugangsnummer).
  userId          String
  // Display label the Berater chose, e.g.
  // "Sparkasse Dreieich — Geschäftskonto".
  label           String
  // The FinTS server URL. Most banks publish
  // their URL via the BPD (Bank Parameter Daten)
  // during dialog init, but for many
  // (Sparkasse, Volksbank) the URL is a static
  // https://banking.s-fints-*.de/PinTanServlet
  // that we resolve from BLZ via lookup.
  endpointUrl     String
  // 0 = real, 1 = mock-mode (returns canned
  // data without touching the bank). Mock is
  // the default for new connections in dev/test
  // environments. Set FINTS_MOCK=0 to opt out
  // of mock globally.
  mockMode        Int       @default(0)
  // sha256 of the user's PIN. Stored so a
  // repeated bad-PIN attempt can be detected
  // before we re-open the dialog (banks
  // return 9910 / PIN_INVALID for a
  // sha256-hash probe — we don't want to
  // call the real dialog just to learn the
  // PIN is wrong). Used in mock-mode only.
  // For real banks, see encryptedPin below.
  pinHash         String?
  // Tier 22: real banks need the PLAINTEXT
  // PIN for the DIALOG INIT's HNVSK envelope
  // (HMAC needs the actual key, not a hash).
  // We encrypt with AES-256-GCM using a key
  // derived from FINTS_PIN_ENC_KEY in .env.
  // The 3-tuple (iv, tag, ciphertext) is
  // base64-encoded. Without FINTS_PIN_ENC_KEY
  // the field stays NULL and real-mode is
  // unavailable for this connection (the
  // user gets a 400 explaining what to set).
  encryptedPin    String?
  pinIv           String?
  pinTag          String?
  // PSD2 strong-customer-authentication. The
  // bank assigns the mechanism at first
  // dialog-init; we just remember the chosen one.
  tanMethod       String?
  // System-Id assigned by the bank at first
  // successful dialog (HKSYN response). Used
  // to resume the dialog without re-sending
  // the customer-id. Required for
  // PIN/TAN persistence.
  systemId        String?
  // Last dialog-id we used. The bank ties
  // multiple message exchanges inside one
  // dialog; the next sync continues the
  // numbering.
  lastDialogId    String?
  // Last time we successfully opened a
  // dialog. Banks often auto-expire inactive
  // accounts — if this is older than e.g. 30
  // days, the next sync will need a fresh TAN.
  lastSyncAt      DateTime?
  // 'pending' (init not completed),
  // 'active' (init done, ready to sync),
  // 'error' (last sync failed — see
  // lastError).
  status          String    @default("pending")
  lastError       String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  syncRuns FinTSSyncRun[]
  transfers FinTsTransfer[]

  @@index([companyId, status])
  @@index([companyId, blz])
}

// One fetch attempt against the bank. Tracks
// the start/end, how many transactions came back,
// and whether the user had to enter a TAN
// (some banks require a TAN even for HKKAZ).
model FinTSSyncRun {
  id              String    @id @default(uuid())
  connectionId    String
  connection      FinTSConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  companyId       String
  // 'ok' / 'needs_tan' / 'failed'
  status          String
  // Number of transactions actually persisted
  // (after dedupe by endToEndId).
  txCount         Int       @default(0)
  // The TAN challenge text the bank returned
  // (HITAN:hn_challenge) — when status =
  // 'needs_tan', the UI shows this in the
  // modal. NULL when no TAN was required.
  tanChallenge    String?
  // The German error code (HIRMG/HIRMS:rc) and
  // the human-readable text. Most useful for
  // 'failed' status, e.g. "PIN gesperrt" or
  // "TAN ungültig".
  errorCode       String?
  errorMessage    String?
  startedAt       DateTime  @default(now())
  finishedAt      DateTime?

  @@index([connectionId, startedAt])
  @@index([companyId, status])
}

// Tier 10: SEPA-Überweisung / Lastschrift
// initiated via FinTS. Same 2-step TAN flow
// as the read sync (start → needs_tan →
// submit TAN → ok / failed). In mock-mode
// the bank is bypassed entirely and any
// 6-digit PIN/TAN is accepted.
//
// `kind` differentiates Überweisung
// (SEPA Credit Transfer, HKCSE) from
// Lastschrift (SEPA Direct Debit, HKCCS).
// The pain.001 / pain.008 schema builder
// in fints.service.ts uses this to choose
// the XML root element.
//
// `status` lifecycle:
//   draft       — POST /transfers saved but
//                  not yet sent to the bank
//   needs_tan   — HKCSE returned a
//                  HITAN:hn_challenge, user
//                  must enter the TAN
//   ok          — bank acknowledged the
//                  transfer (HIRMG/HIRMS rc=0)
//   failed      — bank rejected (HIRMS rc≠0
//                  OR connection error)
//
// `endToEndId` is the SEPA End-to-End ID
// (max 35 chars, ASCII); re-using the same
// endToEndId for a retry is the canonical
// idempotency key on the bank side, so we
// expose it via the API and pass it through
// unchanged to pain.001/PmtId.
model FinTsTransfer {
  id              String    @id @default(uuid())
  companyId       String
  connectionId    String
  connection      FinTSConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  // 'credit_transfer' (Überweisung) | 'direct_debit' (Lastschrift)
  kind            String
  debtorName      String
  debtorIban      String
  debtorBic       String?
  creditorName    String
  creditorIban    String
  creditorBic     String?
  amount          Decimal   @db.Decimal(12, 2)
  currency        String    @default("EUR")
  purpose         String?
  // SEPA End-to-End ID; max 35 chars.
  endToEndId      String
  status          String    // draft | needs_tan | ok | failed
  // Set when status='needs_tan' — the
  // HITAN:hn_challenge the bank sent, shown
  // verbatim in the modal.
  tanChallenge    String?
  // Set when status='failed' — the
  // HIRMS:rc code (e.g. '9210') and the
  // human-readable text the bank returned.
  errorCode       String?
  errorMessage    String?
  startedAt       DateTime  @default(now())
  finishedAt      DateTime?

  @@index([companyId, status, startedAt])
  @@index([connectionId, startedAt])
  @@index([endToEndId])
}

// Tier 7: Custom invoice templates. Each
// template is a per-company preset of PDF
// styling (primary color, font, layout
// density, footer text, custom labels).
// The Invoice.templateType field still
// holds a string ('standard' / 'simplified'
// / 'compact' / 'custom'); when it's
// 'custom' the system looks up the
// linked InvoiceTemplate and applies its
// config at render time.
//
// configJson shape (validated at the API
// boundary, not enforced by Prisma — the
// JSONB is intentionally schema-less so
// we can add fields without a migration):
//   {
//     primaryColor: "#1e3a8a",        // hex, used for header bar
//     accentColor:  "#64748b",        // hex, used for total row
//     textColor:    "#0f172a",        // hex, used for body text
//     fontFamily:   "Helvetica" | "Times-Roman" | "Courier",
//     layoutDensity:"comfortable"|"compact",
//     showLogo:     true|false,
//     footerText:   "Vielen Dank für Ihren Auftrag.",
//     paymentTermsText: "Zahlbar binnen 14 Tagen ohne Abzug.",
//     showAbsenderzeile: true|false,    // top 5pt sender line
//     reverseChargeNote: "Steuerschuldnerschaft des Leistungsempfängers (§13b UStG).",
//     kleineUnternehmerNote: "Gemäß §19 UStG wird keine USt berechnet."
//   }
model InvoiceTemplate {
  id          String   @id @default(uuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  // Human-readable name, e.g. "Standard (SH Leder)",
  // "Kleinunternehmer (§19)", "B2B Reverse Charge".
  name        String
  // The TypeScript templateType this template
  // maps to. Custom templates use 'custom' here
  // and the renderer reads configJson. The
  // built-in 'standard' / 'simplified' /
  // 'compact' templates have their config
  // hard-coded in the renderer (so they
  // always render even with no DB row).
  templateType String   @default("custom")
  // The styling + content config (see
  // comment above for full schema).
  configJson  Json
  // At most one template per company can
  // be the default. The renderer falls
  // back to the default when an Invoice
  // doesn't have a templateId set.
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([companyId, isDefault])
  @@index([companyId, templateType])
}

/// Tier 83: Anlagenverzeichnis (Sachanlagen / fixed
/// assets) per § 266 HGB Aktiva A. Anlagevermögen.
///
/// Each row is one Sachanlage the company owns.
/// The AfaService computes the linear-AfA
/// schedule in-memory from anschaffungsDatum +
/// anschaffungsKosten + nutzungsdauerMonate +
/// restwert. The BilanzService reads the pool
/// at a snapshot date (typically Dec 31) to fill
/// the 0100-0500 Anlagevermögen positions; the
/// GuVService uses the annual AfA to fill the
/// 7a Abschreibungen line.
///
/// Bilanz mapping (§ 266 HGB, simplified v1):
///   - Grundstueck       → 0200
///   - Gebaeude          → 0200
///   - Maschine          → 0300
///   - Fahrzeug          → 0400
///   - Betriebsausstattung → 0400
///   - GWG (≤ 800 EUR)   → 0400 (Sofortabschreibung
///                          in the year of purchase;
///                          not amortised over ND —
///                          v1 simplification: we use
///                          linear AfA but the AfA
///                          sum of the year is the
///                          expense)
///   - Software          → 0100
///   - Sonstiges         → 0400
///
/// v2 work (not in scope):
///   - Geometric / degressive AfA
///   - Außerplanmäßige Abschreibungen (§ 253
///     Abs. 3 HGB) + Zuschreibungen
///   - Component approach (§ 253 Abs. 1 HGB S. 2)
///   - Split GWG pool into separate Bilanz position
///     (real accounting tracks GWG separately)
///   - AfA-Buch (separate journal) for partial-
///     year disposals
model Asset {
  id            String   @id @default(uuid())
  companyId     String
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  // 'Grundstueck' | 'Gebaeude' | 'Maschine' |
  // 'Fahrzeug' | 'Betriebsausstattung' | 'GWG' |
  // 'Software' | 'Sonstiges'
  type          String
  // Human-readable description, e.g. "Büro-Stuhl
  // ergonomisch", "Firmenwagen VW Caddy".
  bezeichnung   String
  // Acquisition date. The AfA clock starts here.
  anschaffungsDatum DateTime
  // AHK (Anschaffungs-/Herstellungskosten). The
  // gross cost basis; AfA is computed against
  // (AHK - restwert).
  anschaffungsKosten Decimal  @db.Decimal(14, 4)
  // Nutzungsdauer in months per AfA-Tabelle
  // (BMF, § 7 Abs. 1 EStG). Common: 36 months
  // (Büroausstattung), 60 (Maschine), 96 (Fahrzeug),
  // 240-600 (Gebäude), etc.
  nutzungsdauerMonate Int
  // Residual value (Restwert) at end of ND. Most
  // business assets have Restwert = 0.
  restwert      Decimal  @db.Decimal(14, 4) @default(0)
  // AfA method. v1 supports 'linear' only. v2
  // would add 'geometric' (degressive) for § 7
  // Abs. 2 EStG assets.
  afaMethode    String   @default("linear")
  // Optional override: which Bilanz position this
  // asset maps to. NULL = automatic mapping from
  // `type`. Useful when a user wants a Maschine
  // mapped to 0400 instead of 0300 (e.g. a
  // piece of Betriebsausstattung that happens
  // to be technical in nature).
  bilanzKonto   String?
  notiz         String?
  // When the asset is sold / disposed. After
  // verkauftAm is set, the asset no longer
  // contributes to the Bilanz pool (the
  // disposal event is the cutoff).
  verkauftAm    DateTime?
  // Sale price at disposal. NULL for write-offs.
  verkaufsPreis Decimal? @db.Decimal(14, 4)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([companyId])
  @@index([companyId, type])
  @@index([companyId, anschaffungsDatum])
  @@index([verkauftAm])
}

// Tier 108: SEPA pain.001 batch payment tracking.
// The SepaBatch represents one XML export — typically
// a monthly run that batches all "unpaid" expenses
// into a single pain.001 file the Berater hands to
// the bank (via the bank's online banking portal).
// The pain.001 XML content is stored on the row
// (size <50KB for typical batches with 50-100
// payments, so storing in the DB is fine and avoids
// a separate file system dependency).
//
// Status flow: draft → generated → submitted →
// confirmed (or failed). v1 only persists draft +
// generated; the user manually submits the XML to
// the bank and updates the status to "submitted"
// (v2: auto-detect via bank statement import).
model SepaBatch {
  id              String   @id @default(uuid())
  companyId       String
  company         Company  @relation(fields: [companyId], references: [id])
  // The pain.001 XML content (UTF-8). Stored
  // inline because the file is small + the user
  // expects to re-download it from the UI later.
  xmlContent      String   @db.Text
  // Aggregated for fast list rendering.
  paymentCount    Int
  totalAmount     Decimal  @db.Decimal(14, 4)
  // IBAN of the debtor (the company's own bank
  // account). Defaults to Company.bankInfo.iban
  // but can be overridden per batch (e.g. the
  // Berater pays one batch from the main account,
  // another from a sub-account).
  debtorIban      String
  debtorBic       String?
  debtorName      String
  // The planned execution date (SettlementDate
  // in pain.001 parlance). NOT the actual bank
  // settlement date — the bank statement
  // reconciles days later via auto-import.
  executionDate   DateTime
  // The user's optional note (e.g. "März-
  // Lieferantenrunde" / "March vendor run").
  notes           String?
  // Status: draft | generated | submitted | confirmed | failed
  status          String   @default("generated")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  expenses        Expense[] @relation("ExpensePaidByBatch")

  @@index([companyId, executionDate])
  @@index([companyId, status])
}

// Tier 112: SEPA pain.008 (Lastschrift / Direct Debit)
// Mandat (Lastschriftmandat). Per the SEPA Core Direct
// Debit Scheme Rulebook (CORE) and the SEPA Business-to-
// Business Direct Debit Scheme Rulebook (B2B), every
// direct debit collection must reference a valid mandate
// previously signed by the debtor (the customer). The
// mandate carries:
//   - Mandatsreferenz (mandate reference): unique
//     alphanumeric ID assigned by the creditor
//   - Datum der Unterschrift (date of signature): the
//     day the customer signed the paper / online
//     mandate form
//   - Typ (type): 'CORE' (B2C, the default) or 'B2B'
//     (business-to-business, no Widerruf protection)
//   - IBAN + BIC + Kontoinhaber of the debtor account
//     (validated at signature time; later changes
//     require a new mandate per §5.5 of the Rulebook)
//
// A mandate can be revoked by either side. We mark it
// `status='revoked'` instead of deleting so that the
// audit trail of past collections is preserved. The
// Bank can also signal "Lastschrift rückbelastet"
// (R-Transaction / Rücklast) — that lives on the
// SepaDirectDebitReturn table, not here.
model SepaDirectDebitMandate {
  id                String   @id @default(uuid())
  companyId         String
  company           Company  @relation(fields: [companyId], references: [id])
  customerId        String
  customer          Customer @relation(fields: [customerId], references: [id])

  // Mandatsreferenz. Unique per company (the
  // Bundesbank convention) but not per customer —
  // a single customer could in theory sign multiple
  // mandates for different purposes (e.g. one for
  // membership fees, one for shop purchases). We
  // generate this on create if not provided.
  mandateReference  String
  // Datum der Unterschrift. The ISO date the customer
  // signed the mandate. Required by §5.2 of the
  // Scheme Rulebook.
  dateOfSignature   DateTime
  // 'CORE' = SEPA Core Direct Debit (B2C, default,
  //   8-week Widerrufsrecht for the debtor, 14-day
  //   Vorabankündigung required) or 'B2B' =
  //   SEPA B2B Direct Debit (business-to-business,
  //   no Widerrufsrecht, 1-day Vorabankündigung).
  //   The type determines the `<LclInstrm><Cd>` in
  //   the pain.008 XML and the pre-notification
  //   deadline logic.
  type              String   @default("CORE")
  // The debtor's account that's being debited.
  iban              String
  bic               String?
  // The Kontoinhaber (account holder). We capture
  // it because it may differ from Customer.name
  // (e.g. third-party payer).
  debitorName       String
  // Optional description (e.g. "Mitgliedsbeitrag
  // 2026" or "Strom-Abo DE123456789"). Free-form.
  description       String?
  // 'active' | 'revoked'. Default 'active'. A
  // revoked mandate can no longer be used for new
  // collections, but historical collections still
  // reference it.
  status            String   @default("active")
  // Optional timestamp of when the mandate was
  // revoked (NULL when still active).
  revokedAt         DateTime?
  // Optional reason for the revocation (free-form,
  // e.g. "Kunde hat Vertrag gekündigt").
  revokedReason     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Back-relation to the direct-debit batches that
  // used this mandate. A single mandate can power
  // many collections (recurring subscriptions) or
  // just one (single-shot ad-hoc).
  collections       SepaDirectDebitCollection[]

  @@unique([companyId, mandateReference])
  @@index([companyId, customerId])
  @@index([companyId, status])
}

// Tier 112: One row per DrctDbtTxInf in a pain.008
// batch. Linking through a junction table (rather
// than directly on the batch) lets us model the
// many-to-one between Collection and Mandate (one
// mandate can be used by many collections) AND the
// one-to-many between Collection and Batch (one
// batch has many collections). Each row also
// records the Pre-Notification (Vorabankündigung)
// tracking: when we sent the advance notice to
// the customer, and the deadline (T-minus 14 for
// CORE, T-minus 1 for B2B).
model SepaDirectDebitCollection {
  id                  String   @id @default(uuid())
  companyId           String
  company             Company  @relation(fields: [companyId], references: [id])
  batchId             String
  batch               SepaDirectDebitBatch @relation("BatchCollections", fields: [batchId], references: [id], onDelete: Cascade)
  mandateId           String
  mandate             SepaDirectDebitMandate @relation(fields: [mandateId], references: [id])
  // The Invoice that's being collected. 1:1 — a
  // single collection targets a single invoice.
  // (For a customer that wants to pay multiple
  // invoices in one debit, the user creates one
  // collection per invoice and the pain.008 PmtInf
  // groups them under one <PmtInf>.)
  invoiceId           String   @unique
  invoice             Invoice  @relation("InvoiceDirectDebit", fields: [invoiceId], references: [id])
  // The amount to collect in EUR. May differ from
  // Invoice.total if the user wants to split the
  // invoice across multiple debits (rare; v1 just
  // requires total == invoice.total).
  amount              Decimal  @db.Decimal(14, 4)
  // The pre-notification (Vorabankündigung) tracking:
  // when we sent the advance notice + the deadline
  // (T-minus 14 for CORE, T-minus 1 for B2B).
  preNotificationSentAt DateTime?
  preNotificationDeadline DateTime?
  // 'pending' | 'pre_notified' | 'collected' | 'failed' | 'returned'
  //   pending:       created, not yet due
  //   pre_notified:  Vorabankündigung sent
  //   collected:     bank confirmed the debit
  //   failed:        could not collect (e.g. no mandate)
  //   returned:      R-Transaction (Rücklastschrift)
  // v1 sets this to 'pre_notified' on batch creation
  // (we treat the batch generation as the moment of
  // pre-notification — the user is expected to email
  // the customer themselves; v2 wires up an actual
  // email send).
  status              String   @default("pre_notified")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([companyId, batchId])
  @@index([companyId, mandateId])
  @@index([status])
}

// Tier 112: SEPA pain.008 batch header (the Sammel-
// Lastschrift). The XmlContent is the entire pain.008
// document; one batch = one PmtInf = one debtor
// (the company) debiting N customers. This is the
// inverse of Tier 108 (pain.001) where one batch
// debits one creditor (the company) crediting N
// suppliers. The two are symmetric on the XML side
// but opposite on the accounting side.
model SepaDirectDebitBatch {
  id                  String   @id @default(uuid())
  companyId           String
  company             Company  @relation(fields: [companyId], references: [id])
  // The pain.008 XML content. UTF-8 inline.
  xmlContent          String   @db.Text
  // Aggregated for fast list rendering.
  collectionCount     Int
  totalAmount         Decimal  @db.Decimal(14, 4)
  // The creditor (we, the company) is on the receiving
  // side. We default to Company.bankInfo.iban etc.
  // but allow per-batch override (e.g. a separate
  // Gläubiger-ID per brand).
  creditorIban        String
  creditorBic         String?
  creditorName        String
  // The Gläubiger-Identifikationsnummer (creditor
  // identifier) assigned by the Bundesbank to the
  // company. Required for all SEPA Core / B2B
  // direct debits — without it, the bank rejects
  // the batch. Format: 18 chars (DE + 2 check
  // digits + 8-char Geschäftsbereich + 5-char
  // Register-Nr + 1 filler). Defaults to a
  // company-level setting; can be overridden.
  creditorIdentifier  String
  // The planned collection date (SettlementDate for
  // the creditor; EarliestSettlementDate for the
  // debtor). The bank settles T+1 for B2C CORE,
  // T+1 for B2B.
  executionDate       DateTime
  // 'CORE' | 'B2B' — affects the `<LclInstrm><Cd>`,
  // the pre-notification deadline logic, and the
  //   acceptance window. The whole batch has ONE
  //   type (per §2.2 of the Rulebook, a PmtInf
  //   can only carry transactions of a single
  //   type).
  type                String   @default("CORE")
  // The user's optional note (e.g. "Monats-
  // Beiträge" / "Monthly fees").
  notes               String?
  // Status: draft | generated | submitted | confirmed | failed
  status              String   @default("generated")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  // Back-relations
  collections         SepaDirectDebitCollection[] @relation("BatchCollections")
  // The invoices that were collected by this batch.
  // Symmetric to the ExpensePaidByBatch pattern on
  // SepaBatch (pain.001), but for invoices (not
  // expenses) since direct debits target the
  // customer's invoice.
  invoices            Invoice[] @relation("InvoiceCollectedByBatch")

  @@index([companyId, executionDate])
  @@index([companyId, status])
  @@index([companyId, type])
}

/// Tier 119: System health monitoring for the 7
/// background jobs (webhook-retry, fints-sync,
/// reminder-auto-send, vat-reverify, exchange-rate-
/// refresh, afa-auto-booker, recurring-invoices).
///
/// Each scheduler writes a row after every run via
/// CronHealthService.record(). The list endpoint
/// joins the most-recent row per cron name and
/// surfaces last run + status to the admin UI.
///
/// We keep ~7 days of history (a `cleanOld` cron
/// is wired to a nightly @Cron). Indexed on
/// (name, startedAt DESC) so the per-cron
/// "latest run" lookup is a single index range
/// scan.
model CronHealth {
  id          String   @id @default(uuid())
  // Stable scheduler identifier (matches the
  // @Cron `name:` option in each scheduler).
  // Examples: 'webhook-retry-worker',
  // 'recurring-invoices-daily'.
  name        String
  // 'success' | 'failed' | 'skipped' (env-disabled
  // or no work to do)
  status      String
  // Wall-clock time the scheduler method was
  // entered. The duration column lets the
  // admin spot slow runs without scraping logs.
  startedAt   DateTime @default(now())
  durationMs  Int?
  // Free-text error message (truncated to 1000
  // chars by the service to keep the table small).
  errorMessage String?
  // Free-text summary ("processed 42 templates,
  // 38 succeeded, 4 failed"). For success runs
  // the admin can see at a glance what the cron
  // did without grepping logs.
  summary     String?

  @@index([name, startedAt])
}

// Tier 205 — system-wide notification
// rate-threshold config. The push channel
// only fires when an error fingerprint
// exceeds `rateThresholdCount` occurrences
// within `rateThresholdWindowMinutes` minutes.
// Singleton (no companyId): the threshold is
// a global property of the deploy, not a
// per-tenant setting. If we ever need
// per-tenant thresholds, add a companyId
// + unique index and route lookups by
// event.companyId.
model NotificationConfig {
  id                        String   @id @default(uuid())
  /// Minimum number of occurrences of a
  /// fingerprint within the window before
  /// the notification fires. Default 5
  /// (= 1 burst + 4 follow-ups, so a true
  /// one-off doesn't wake anyone up at 3am).
  rateThresholdCount        Int      @default(5)
  /// Sliding window in minutes for the
  /// count above. Default 60 (1 hour).
  /// At max config (1440) the threshold
  /// means "in the last 24 hours".
  rateThresholdWindowMinutes Int     @default(60)
  updatedAt                 DateTime @updatedAt
  /// Free-text operator note for the audit
  /// trail (e.g. "lowered from 5 to 3 after
  /// the false alarm on Aug 12").
  note                      String?
}
