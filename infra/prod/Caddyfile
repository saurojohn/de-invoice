# ─────────────────────────────────────────────────────────────────
# de-invoice — Caddy reverse-proxy config (Tier 114)
#
# Caddy auto-issues + auto-renews Let's Encrypt certs via the ACME
# HTTP-01 challenge. No certbot, no cron, no manual renewal. Caddy
# reads this file on the fly, so a `caddy reload` (or a container
# restart) is all that's needed to pick up config changes.
#
# This file is mounted into the `caddy` service in
# `docker-compose.yml` (see the `caddy` service definition). The
# caddy container needs ports 80 + 443 on the host so the HTTP-01
# challenge works.
#
# Reverse proxy targets (backend:3001, frontend:3000) resolve via
# the `deinvoicenet` Docker network that all the prod services
# share.
#
# Why Caddy instead of nginx (Tier 17):
#   - Auto-TLS: no certbot, no systemd timer, no cron. Caddy
#     does the ACME dance itself and renews at <30 days left.
#   - Shorter config: this whole file replaces ~280 lines of
#     nginx.conf with equivalent semantics.
#   - Cloudflare real-IP restore is also simpler — Caddy has
#     `trusted_proxies` + `client_ip_headers` for the
#     CF-Connecting-IP header.
# ─────────────────────────────────────────────────────────────────

# ─── Production site ───────────────────────────────────────
# Replace the email with an address you actually monitor — Let's
# Encrypt sends expiry warnings here.
{
    email ops@shleder.de
    # ACME directory: default (production Let's Encrypt).
    # For staging, see Caddyfile.staging.
    acme_ca https://acme-v02.api.letsencrypt.org/directory
}

invoice.shleder.de, www.invoice.shleder.de {

    # Tier 561: this block was rewritten. The one before it did not pass
    # `caddy validate` on the stock caddy:2-alpine image the compose file
    # uses (v2.11): `timeout` is not a reverse_proxy option, `rate_limit` is
    # not a directive of stock Caddy, `reverse_proxy` takes one matcher, not
    # three, and `{path.1}` is not a placeholder. Caddy would not have
    # started. e2e/341 validates both Caddyfiles when the image is present.

    # ── Compression ──────────────────────────────────────
    encode zstd gzip

    # ── Security headers, on every response ──────────────
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "geolocation=(), microphone=(), camera=()"
        -Server
    }

    # ── /metrics is not for the internet ─────────────────
    # It counts companies, users, invoices and customers. Prometheus runs in
    # the same compose network and scrapes backend:3001 directly; nothing
    # outside needs it. (To expose it after all: set METRICS_TOKEN and
    # replace this block with a `handle /metrics { reverse_proxy backend:3001 }`.)
    handle /metrics {
        respond 404
    }

    # ── API ──────────────────────────────────────────────
    # Everything under /api/ goes to the NestJS backend — including
    # /api/v1/health and /api/v1/health/deep for uptime monitors.
    #
    # X-Forwarded-For / -Proto / -Host are set by Caddy itself, from the
    # connection it accepted; what a client sends in those headers is
    # dropped. The backend trusts them from this container (TRUST_PROXY).
    #
    # Rate limiting is the backend's (@Throttle, per visitor address). Stock
    # Caddy has no rate_limit directive; adding one means building Caddy with
    # a plugin.
    handle /api/* {
        reverse_proxy backend:3001 {
            header_up X-Real-IP {remote_host}
            # Stream PDFs and large exports instead of buffering them.
            flush_interval -1
            transport http {
                # /api/v1/accounting/journal/pdf can take 5-10 s for a full
                # year; give the backend a minute to start answering.
                response_header_timeout 60s
            }
        }
    }

    # ── Frontend (Next.js) ───────────────────────────────
    handle {
        @static path /_next/static/* /favicon.ico /robots.txt
        header @static Cache-Control "public, max-age=31536000, immutable"
        reverse_proxy frontend:3000 {
            header_up X-Real-IP {remote_host}
        }
    }

    # ── Access log ───────────────────────────────────────
    # JSON to stdout; `docker logs de-invoice-caddy` has it.
    log {
        output stdout
        level INFO
    }
}

# ─── Optional: Cloudflare real-IP restore ─────────────────
# If you're running behind Cloudflare (orange-cloud DNS), every
# connection comes from a CF edge IP and {remote_host} above is
# the CF edge IP, not the visitor. Caddy has built-in support:
# uncomment the block below to restore the real visitor IP via
# the CF-Connecting-IP header (set by CF, not spoofable).
#
#   1. Get the current CF IP ranges:
#        curl -s https://www.cloudflare.com/ips-v4 > /etc/caddy/cf-ips-v4.txt
#        curl -s https://www.cloudflare.com/ips-v6 > /etc/caddy/cf-ips-v6.txt
#   2. Restart caddy.
#
# Without this, the backend sees every CF-fronted visitor as the same
# edge IP, and its rate limits count them as one.
#
# trusted_proxies static <cf-range-1> <cf-range-2> ...
# client_ip_headers CF-Connecting-IP
