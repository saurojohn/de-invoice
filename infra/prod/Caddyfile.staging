# ─────────────────────────────────────────────────────────────────
# de-invoice — Caddy staging config (Tier 114)
#
# Same shape as Caddyfile, but points at Let's Encrypt's STAGING
# ACME endpoint. The staging endpoint issues dummy certs that
# browsers reject with a scary warning — this is intentional.
# You use this to verify the Caddy config + the domain mapping
# WITHOUT hitting Let's Encrypt's prod rate limit (5 certs / 7
# days / registered domain).
#
# Usage on the staging VPS:
#   caddy run --config /etc/caddy/Caddyfile.staging
#
# OR, if you're running Caddy in the docker-compose stack:
#   docker compose -f docker-compose.yml -f docker-compose.staging.yml up -d
#   # (docker-compose.staging.yml would override the Caddyfile
#   #   bind-mount to Caddyfile.staging)
#
# When you're done testing:
#   - Switch back to the regular Caddyfile
#   - Delete the staging cert from Caddy's data dir
#     (`docker volume rm deinvoicenet_caddy_data` for a clean
#     slate — only if you want to clear the staging certs)
# ─────────────────────────────────────────────────────────────────

{
    # STAGING ACME directory — issues untrusted test certs.
    # DO NOT use in production.
    email ops@shleder.de
    acme_ca https://acme-staging-v02.api.letsencrypt.org/directory
}

staging.rechnung.shleder.de {

    # Tier 561: this block was rewritten. The one before it did not pass
    # `caddy validate` on the stock caddy:2-alpine image the compose file
    # uses (v2.11): `timeout` is not a reverse_proxy option, `rate_limit` is
    # not a directive of stock Caddy, `reverse_proxy` takes one matcher, not
    # three, and `{path.1}` is not a placeholder. Caddy would not have
    # started. e2e/341 validates both Caddyfiles when the image is present.

    # ── Compression ──────────────────────────────────────
    encode zstd gzip

    # ── Security headers, on every response ──────────────
    header {
        Strict-Transport-Security "max-age=300; includeSubDomains"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "geolocation=(), microphone=(), camera=()"
        -Server
    }

    # ── /metrics is not for the internet ─────────────────
    # It counts companies, users, invoices and customers. Prometheus runs in
    # the same compose network and scrapes backend:3001 directly; nothing
    # outside needs it. (To expose it after all: set METRICS_TOKEN and
    # replace this block with a `handle /metrics { reverse_proxy backend:3001 }`.)
    handle /metrics {
        respond 404
    }

    # ── API ──────────────────────────────────────────────
    # Everything under /api/ goes to the NestJS backend — including
    # /api/v1/health and /api/v1/health/deep for uptime monitors.
    #
    # X-Forwarded-For / -Proto / -Host are set by Caddy itself, from the
    # connection it accepted; what a client sends in those headers is
    # dropped. The backend trusts them from this container (TRUST_PROXY).
    #
    # Rate limiting is the backend's (@Throttle, per visitor address). Stock
    # Caddy has no rate_limit directive; adding one means building Caddy with
    # a plugin.
    handle /api/* {
        reverse_proxy backend:3001 {
            header_up X-Real-IP {remote_host}
            # Stream PDFs and large exports instead of buffering them.
            flush_interval -1
            transport http {
                # /api/v1/accounting/journal/pdf can take 5-10 s for a full
                # year; give the backend a minute to start answering.
                response_header_timeout 60s
                # Tier 584: let go of an idle connection BEFORE the backend
                # does (it keeps them 65 s — main.ts). Caddy's default is
                # 2 minutes: between second 65 and 120 it would send a request
                # down a connection the backend is closing — a 502 for a POST
                # (GETs are retried). The pairing was only ever checked
                # against the nginx file this replaced. e2e/194 holds it.
                keepalive 30s
            }
        }
    }

    # ── Frontend (Next.js) ───────────────────────────────
    handle {
        @static path /_next/static/* /favicon.ico /robots.txt
        header @static Cache-Control "public, max-age=31536000, immutable"
        reverse_proxy frontend:3000 {
            header_up X-Real-IP {remote_host}
            transport http {
                # as for the backend: shorter than the frontend's own
                # keep-alive (KEEP_ALIVE_TIMEOUT in docker-compose.yml, 65 s;
                # Node's default would be 5 s)
                keepalive 30s
            }
        }
    }

    # ── Access log ───────────────────────────────────────
    # JSON to stdout; `docker logs de-invoice-caddy` has it.
    log {
        output stdout
        level INFO
    }
}
