# ─────────────────────────────────────────────────────────────────
# de-invoice production .env.example (Tier 114)
#
# Copy this file to `.env` (same directory as docker-compose.yml)
# and fill in the real values. NEVER commit .env.
#
# Quick setup:
#   cd infra/prod
#   cp .env.example .env
#   chmod 600 .env
#   $EDITOR .env
#
# All vars are listed in the order they appear in
# docker-compose.yml + the backup / monitoring scripts.
# Use the comment next to each one to know what it does,
# what the default is, and how to generate a strong value.
#
# Required vars (no default — the stack won't start without them):
#   - POSTGRES_PASSWORD
#   - FRONTEND_URL
#   - JWT_SECRET
#
# Optional vars (have sensible defaults):
#   - POSTGRES_DB (default de_invoice)
#   - POSTGRES_USER (default de_invoice)
#   - ECB_API_URL / ECB_API_BASE
#   - HEALTHCHECK_URL / HEALTHCHECK_PING_URL
#   - FINTS_PIN_ENC_KEY — REQUIRED for a bank
#     connection (the demo bank is off in
#     production). 32+ char string; SHA-256-hashed internally
#     to derive the AES-256 key. Generate one with:
#       openssl rand -hex 32
#   - LOG_LEVEL
#   - BACKUP_RCLONE_REMOTE / BACKUP_ENCRYPTION_PASSPHRASE
#   - SMTP_* (the app's mail), SYSTEM_ADMIN_EMAILS, METRICS_TOKEN,
#     APP_ORIGIN, OCR_ENGINE, FINTS_ALLOW_MOCK — see below
#   - BACKUP_WEBHOOK_URL
# ─────────────────────────────────────────────────────────────────

# ─── Database ──────────────────────────────────────────────
# Strong password. Generate one with:
#   openssl rand -base64 32
POSTGRES_DB=de_invoice
POSTGRES_USER=de_invoice
POSTGRES_PASSWORD=CHANGE_ME_TO_A_STRONG_RANDOM_PASSWORD

# ─── Public URL ────────────────────────────────────────────
# The URL users type in their browser. Used by:
#   - CORS allowlist on the backend
#   - Password-reset links in emails (when added)
#   - PDF "view online" links
#   - VIES/ELSTER redirect URLs (future)
FRONTEND_URL=https://rechnung.shleder.de

# ─── Auth ─────────────────────────────────────────────────
# 64+ random hex chars. Generate with:
#   openssl rand -hex 32
# Rotating this invalidates ALL existing sessions (everyone
# has to log in again). Rotate on suspected compromise.
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_HEX_STRING

# ─── FinTS (Tier 22) ──────────────────────────────────────
# AES-256-GCM key for at-rest encryption of online-banking
# PINs (real-mode connections only — mock-mode ignores it).
# Generate with:
#   openssl rand -hex 32
# Required for any real-bank integration. Without it,
# real-mode connection creation leaves the encrypted PIN
# columns NULL and the sync refuses to start with a clear
# error. KEEP SECRET — losing this key means every bank
# connection must be re-created.
FINTS_PIN_ENC_KEY=

# ─── Application ──────────────────────────────────────────
# Log verbosity. One of: error, warn, log, debug, verbose.
# Default: log. Bump to debug when troubleshooting a specific
# request; never leave it on verbose in prod (very chatty).
LOG_LEVEL=log

# ─── Backup monitoring (Tier 14 + Tier 114) ───────────────
# Optional: Healthchecks.io integration. After each successful
# backup, the backup container pings this URL. If a backup is
# missed, Healthchecks.io emails you.
#
# Get a UUID from https://healthchecks.io/ and append the
# slug for the check (e.g. /abc123-def456-...):
#   HEALTHCHECK_URL=https://hc-ping.com/abc123-def456-...
#   HEALTHCHECK_PING_URL=https://hc-ping.com/abc123-def456-/fail
#
# Leave empty to disable (backups still run, just no alerts).

# ─── Tier 114 — Off-site backup (rclone) ──────────────────
# Used by scripts/backup-prod.sh to push the nightly
# pg_dump to remote storage. rclone is configured
# separately (run `rclone config` on the host) and
# these vars just point to the named remote + path.
#
# Examples:
#   BACKUP_RCLONE_REMOTE=hetzner-storagebox:de-invoice-backups
#   BACKUP_RCLONE_REMOTE=do-spaces:de-invoice-backups
#   BACKUP_RCLONE_REMOTE=s3:my-bucket/de-invoice
#   BACKUP_RCLONE_REMOTE=    # leave empty to disable offsite
#
# Encryption (optional but strongly recommended):
# The backup is symmetric-encrypted with gpg before upload,
# so a leaked S3 credential does NOT leak your customer data.
# The passphrase is required to restore. Store it in your
# password manager (1Password / Bitwarden), NOT on the VPS.
#   openssl rand -base64 24
BACKUP_RCLONE_REMOTE=
BACKUP_ENCRYPTION_PASSPHRASE=

# Webhook for backup results (Slack / Discord / etc).
# posts a JSON payload on success AND on failure so you
# can route them to different channels in your webhook
# receiver. Format: incoming-webhook URL.
BACKUP_WEBHOOK_URL=

# Retention policy (Tier 114 — replaces the old 7/4/monthly).
# 30 daily + 7 weekly + 12 monthly covers the GoBD
# "Aufbewahrungsfrist" of 10 years via the monthly anchors.
# The default values below are fine for SH Leder's size.
BACKUP_KEEP_DAILY=30
BACKUP_KEEP_WEEKLY=7
BACKUP_KEEP_MONTHLY=12

# ─── Optional integrations ───────────────────────────────
# ECB reference rates (foreign-currency invoices). Both empty: the ECB's own
# address, data-api.ecb.europa.eu — the backend must be able to reach it.
# ECB_API_URL is the nightly request for seven currencies; ECB_API_BASE the
# address under which the rate of one currency on one day is asked for
# (…/service/data/EXR), when an invoice in a foreign currency is written.
ECB_API_URL=
ECB_API_BASE=

# ─── Grafana (only used when you bring up the observability ───
# overlay: docker-compose.observability.yml, OR the
# Tier 114 monitoring.yml).
# Default is admin/admin — CHANGE THIS in any
# non-localhost deployment.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD

# ─── Alertmanager (Tier 23) ──────────────────────────────
# Slack Incoming Webhook URL. Create one in your Slack
# workspace under "Apps → Incoming Webhooks". Without
# this set, Alertmanager starts and Prometheus fires
# alerts into it, but the Slack receivers fail to deliver
# (visible at http://127.0.0.1:9093/alerts in the
# observability stack's debug UI).
SLACK_WEBHOOK_URL=
SLACK_CHANNEL_CRITICAL=#ops-alerts
SLACK_CHANNEL_WARNING=#ops-warning
# Slack user group handle for @-mentions on critical alerts.
# Set up the group in Slack first, then put its handle here
# (e.g. "@oncall" or "@ops-team").
SLACK_ONCALL_HANDLE=@oncall

# SMTP for the email fallback on critical alerts.
# Most providers want an app-specific password, not your
# real one. Test with:
#   docker compose -f infra/prod/docker-compose.yml \
#                  -f infra/prod/docker-compose.observability.yml \
#                  exec alertmanager wget -qO- http://localhost:9093/-/ready
SMTP_SMARTHOST=smtp.your-provider.com:587
SMTP_FROM=alertmanager@your-domain.com
SMTP_AUTH_USERNAME=alertmanager@your-domain.com
SMTP_AUTH_PASSWORD=
OPS_EMAIL=ops@your-domain.com

# ─── SMTP (transactional — invoices, password reset) ─────
# Tier 114: split out from the alertmanager SMTP above
# because they have different concerns (transactional
# email needs DKIM/SPF, alerts don't).
#
# Used by the backend's EmailService. If unset, the
# backend falls back to a console transport (logs emails
# instead of sending) — fine for dev, NOT for prod.
#
# Tier 584: these are the names the backend reads (docker-compose.yml hands
# exactly these on). This block used to say SMTP_PASS and SMTP_FROM — a
# password set under that name never reached the backend.
# A company can also enter its own SMTP account in the app (Einstellungen →
# E-Mail); these are the installation's default.
# SMTP_HOST=smtp.your-provider.com
# SMTP_PORT=587
# SMTP_SECURE=false            # true for port 465 (TLS from the first byte)
# SMTP_USER=noreply@shleder.de
# SMTP_PASSWORD=<app-specific password>
# SMTP_FROM_NAME=SH Leder GmbH
# SMTP_FROM_EMAIL=noreply@shleder.de

# ─── Application: optional settings ───────────────────────
# All of these have working defaults; docker-compose.yml passes them to the
# backend (a variable that is only written here and not listed there does
# not reach it).
#
# Who may use the installation-wide routes (backups, schedulers, storage
# settings, system notifications): the admins of the OLDEST company. With
# addresses here (comma-separated), only those of them.
# SYSTEM_ADMIN_EMAILS=admin@your-domain.com
#
# When set, GET /metrics needs `Authorization: Bearer <token>`. The proxy
# does not forward /metrics at all; this protects it inside the Docker
# network too. If you set it, put the same token into
# prometheus/prometheus.yml (see the comment there).
# METRICS_TOKEN=
#
# The public origin used in links the backend writes into e-mails, when it
# differs from FRONTEND_URL (normally leave unset).
# APP_ORIGIN=
#
# The receipt scanner: "tesseract" (default) reads the picture; "mock"
# answers every scan with one invented receipt — development only.
# OCR_ENGINE=tesseract
#
# The demo bank with invented transactions. 0 (default) = off; 1 only for a
# demo installation — never where real books are kept.
# FINTS_ALLOW_MOCK=0

# ─── Internal notes ───────────────────────────────────────
# The compose file also sets DATABASE_URL for the backend.
# It is built from POSTGRES_USER + POSTGRES_PASSWORD, so you
# only edit those two values. Don't override DATABASE_URL
# directly — the connection_limit=8 parameter is critical
# for not exhausting Postgres max_connections=100 during
# regression tests.
