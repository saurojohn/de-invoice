# ─────────────────────────────────────────────────────────────────
# de-invoice production .env.example
#
# Copy this file to `.env` (same directory as docker-compose.yml)
# and fill in the real values. NEVER commit .env.
#
# Quick setup:
#   cd infra/prod
#   cp .env.example .env
#   $EDITOR .env
#
# Required vars (no default):
#   - POSTGRES_PASSWORD
#   - FRONTEND_URL
#   - JWT_SECRET
#
# Optional vars (have sensible defaults):
#   - POSTGRES_DB (default de_invoice)
#   - POSTGRES_USER (default de_invoice)
#   - ECB_API_URL
#   - HEALTHCHECK_URL / HEALTHCHECK_PING_URL
#   - FINTS_PIN_ENC_KEY — REQUIRED for real-mode
#     FinTS connections (mock-mode works without
#     it). 32+ char string; SHA-256-hashed internally
#     to derive the AES-256 key. Generate one with:
#       openssl rand -hex 32
# ─────────────────────────────────────────────────────────────────

# ─── Database ──────────────────────────────────────────────
# Strong password. Generate one with:
#   openssl rand -base64 32
POSTGRES_DB=de_invoice
POSTGRES_USER=de_invoice
POSTGRES_PASSWORD=CHANGE_ME_TO_A_STRONG_RANDOM_PASSWORD

# ─── Public URL ────────────────────────────────────────────
# The URL users type in their browser. Used by:
#   - CORS allowlist on the backend
#   - Password-reset links in emails (when added)
#   - PDF "view online" links
#   - VIES/ELSTER redirect URLs (future)
FRONTEND_URL=https://rechnung.shleder.de

# ─── Auth ─────────────────────────────────────────────────
# 64+ random hex chars. Generate with:
#   openssl rand -hex 32
# Rotating this invalidates ALL existing sessions (everyone
# has to log in again). Rotate on suspected compromise.
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_HEX_STRING

# ─── FinTS (Tier 22) ──────────────────────────────────────
# AES-256-GCM key for at-rest encryption of online-banking
# PINs (real-mode connections only — mock-mode ignores it).
# Generate with:
#   openssl rand -hex 32
# Required for any real-bank integration. Without it,
# real-mode connection creation leaves the encrypted PIN
# columns NULL and the sync refuses to start with a clear
# error. KEEP SECRET — losing this key means every bank
# connection must be re-created.
FINTS_PIN_ENC_KEY=

# ─── Backup monitoring ────────────────────────────────────
# Optional: Healthchecks.io integration. After each successful
# backup, the backup container pings this URL. If a backup is
# missed, Healthchecks.io emails you.
#
# Get a UUID from https://healthchecks.io/ and append the
# slug for the check (e.g. /abc123-def456-...):
#   HEALTHCHECK_URL=https://hc-ping.com/abc123-def456-...
#   HEALTHCHECK_PING_URL=https://hc-ping.com/abc123-def456-/fail
#
# Leave empty to disable (backups still run, just no alerts).

# ─── Optional integrations ───────────────────────────────
# ECB rates API. Leave empty to disable.
ECB_API_URL=

# ─── Grafana (only used when you bring up the observability ───
# overlay: docker-compose.observability.yml).
# Default is admin/admin — CHANGE THIS in any
# non-localhost deployment.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD

# ─── Internal notes ───────────────────────────────────────
# The compose file also sets DATABASE_URL for the backend.
# It is built from POSTGRES_USER + POSTGRES_PASSWORD, so you
# only edit those two values. Don't override DATABASE_URL
# directly — the connection_limit=8 parameter is critical
# for not exhausting Postgres max_connections=100 during
# regression tests.